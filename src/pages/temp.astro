---
import "../styles/global.css";
import BuisinessCard from "../components/BuisinessCard.astro";
---

<div
  class="flex h-screen w-screen flex-col items-center justify-center bg-red-100"
>
  <div class="h-50px flex w-full flex-col items-center bg-green-100 p-20">
    <div class="perspective-[1000px]">
      <div class="aspect-3/2 w-80 rotate-x-10 rotate-y-20 rounded-xl ">
        <BuisinessCard
          name="Minato Hayashi"
          age="23+"
          location="Osaka, Japan"
          pronoun="He / Him"
          study="reinforcement learning"
        />
      </div>
    </div>
  </div>
</div>
