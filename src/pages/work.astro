---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ActionLog from "../components/ActionLog.astro";
import ImageStack from "../components/ImageStack.astro";
import LeftNav from "../components/LeftNav.astro";
import NotificationStrip from "../components/NotificationStrip.astro";
import IllustGallery from "../components/IllustGallery.astro";

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";

const items = [
  "/images/gallery/orange.png",
  "/images/gallery/purple.png",
  "/images/gallery/pink.png",
  "/images/gallery/white.png",
];
---

<Layout title={title} description={description}>
  <div class="flex flex-col lg:h-full lg:min-h-0">
    <div class="flex flex-col lg:min-h-0 lg:flex-1 lg:flex-row">
      <!-- 左 -->
      <aside
        class="flex w-full shrink-0 flex-col gap-4 p-4 lg:w-110 lg:justify-around lg:gap-5 lg:px-5"
      >
        <LeftNav />
      </aside>

      <!-- 右 -->
      <main
        class="flex w-full min-w-0 flex-col px-4 py-3 lg:min-h-0 lg:flex-1 lg:px-7 lg:py-10"
      >
        <h1 class="mb-6 text-2xl font-semibold text-zinc-800">work</h1>

        <div class="no-scrollbar flex min-h-0 flex-1 flex-col overflow-y-auto">
          <div class="w-full">
            <section class="mt-10 flex h-full w-full flex-col gap-4">
              <h2>gallery (AI illusts)</h2>
              <!-- <ImageStack images={items} maxWidth="400px" /> -->
              <IllustGallery images={items} maxHeight="350px" />
            </section>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>
