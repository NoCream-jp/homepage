---
import Layout from "../layouts/Layout.astro";
import NewsItem from "../components/NewsItem.astro";

import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allNews = await getCollection("news");
const sortedNews = allNews.sort(
  (a: CollectionEntry<"news">, b: CollectionEntry<"news">) =>
    b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout>
  <section
    id="news"
    class="mt-header h-auto bg-white p-10 md:mt-0 md:scroll-mt-0 lg:mt-0 lg:p-15"
  >
    <div class="section-header mb-20 lg:ml-10">
      <h2 class="font-sans text-5xl font-bold">News</h2>
    </div>
    <div class="main-container md:mr-20 md:px-10 lg:px-20 lg:pr-50">
      {
        sortedNews.map((item) => (
          <NewsItem
            date={item.data.date}
            title={item.data.title}
            href={item.data.href}
          />
        ))
      }
    </div>
  </section>
</Layout>
