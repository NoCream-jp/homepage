---
import Layout from "../layouts/Layout.astro";
import WordCloud from "../components/WordCloud.astro";
import ImageStack from "../components/ImageStack.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ActionLog from "../components/ActionLog.astro";

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";

const sampleImages = [
  "/images/cat.webp",
  "/images/atcoder.png",
  "/images/ra-men.webp",
  "/images/spotify.webp",
];

const cwords = [
  "AtCoder",
  "学園アイドルマスター",
  "東野圭吾",
  "QuizKnock",
  "星街すいせい",
  "KALDI",
  "ハリー・ポッター",
  "ポケットモンスターチャンピオンズ",
  "Spotify",
  "Arena Breakout",
  "Anker",
  "ナナホシ管弦楽団",
  "Orangestar",
  "米津玄師",
  "The Amasing Degital Circus",
];
---

<Layout title={title} description={description}>
  <div class="mx-auto mt-8 w-full max-w-3xl px-4 md:px-6">
    <Breadcrumbs
      items={[
        { label: "TOP", href: "/" },
        { label: "bio", href: "/bio" },
      ]}
    />

    <section class="my-10 w-full space-y-12">
      <h1 class="text-2xl font-semibold text-zinc-800">bio</h1>

      <!-- Who I am -->
      <div>
        <div class="mb-4 text-sm text-zinc-500">Who I am</div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-10">
          <p class="leading-relaxed text-zinc-900">
            こんにちは。みなとといいます。大学4回生で、AIや機械学習、ブロックチェーン、ネットワークについて学んでいます。
            webサイトを作ったり、競技プログラミングに参加したりしています。現在は、英語でアニメを見るのに熱中しています。
            寝ること、食べること、音楽を聴くこと、猫とお話することが好きです。美しいと思ったものはなんでも勉強します。どうぞよろしく。
          </p>

          <p class="leading-relaxed text-zinc-900">
            Hi. I'm Minato Hayashi, a senior university student in Japan. I'm
            learning AI, machine learning, blockchain, network, and more. I
            recently make websites and articles, participate in competitive
            programming. I love eating, sleeping, and talking with cats. Have
            fun everything with me !!
          </p>
        </div>
      </div>

      <!-- What I saw -->
      <div>
        <div class="mb-4 text-sm text-zinc-500">What I saw</div>

        <div
          class="flex flex-col items-center gap-6 md:flex-row md:items-center md:gap-10"
        >
          <ImageStack images={sampleImages} />

          <p class="text-zinc-900">
            各種SNSには猫の画像、外食の際撮影した写真、その他趣味関連の画像を投稿しています。
          </p>
        </div>
      </div>

      <!-- What I like -->
      <div>
        <div class="mb-4 text-sm text-zinc-500">What I like</div>

        <WordCloud
          words={cwords}
          width="100%"
          height="250px"
          maxFont={50}
          minFont={35}
        />
      </div>

      <!-- What I did -->
      <div>
        <div class="mb-4 text-sm text-zinc-500">What I did</div>

        <ActionLog limit={10} />
      </div>
    </section>
  </div>
</Layout>
