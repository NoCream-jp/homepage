---
import Layout from "../layouts/Layout.astro";
import LeftNav from "../components/LeftNav.astro";
import ImageStack from "../components/ImageStack.astro";
import LearningCard from "../components/LearningCard.astro";
import { getCollection } from "astro:content";

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";

const sampleImages = [
  "/images/cat.webp",
  "/images/atcoder.png",
  "/images/ra-men.webp",
  "/images/spotify.webp",
];

const learning = await getCollection("learning");
---

<Layout title={title} description={description}>
  <div class="flex flex-col lg:h-full lg:min-h-0">
    <div class="flex flex-col lg:min-h-0 lg:flex-1 lg:flex-row">
      <!-- 左 -->
      <aside
        class="flex w-full shrink-0 flex-col gap-4 p-4 lg:w-110 lg:justify-around lg:gap-5 lg:px-5"
      >
        <LeftNav />
      </aside>

      <!-- 右 -->
      <main
        class="flex w-full min-w-0 flex-col px-4 py-3 lg:min-h-0 lg:flex-1 lg:px-7 lg:py-10"
      >
        <h1 class="mb-4 text-2xl font-semibold text-zinc-800">bio</h1>

        <div class="no-scrollbar flex min-h-0 flex-1 flex-col overflow-y-auto">
          <div class="w-full">
            <section class="mt-5 flex w-full flex-col gap-4">
              <h2>Who I am</h2>

              <div class="rounded-md border p-5">
                <div>
                  こんにちは。みなとといいます。大学4回生で、AIや機械学習、ブロックチェーン、ネットワークについて学んでいます。
                  ウェブサイトを作ったり、競技プログラミングに参加したりしています。現在は、英語でアニメを見るのに熱中しています。
                  寝ること、食べること、音楽を聴くこと、猫とお話することが好きです。美しいと思ったものはなんでも勉強します。どうぞよろしく。
                </div>
              </div>

              <h2>What I saw</h2>

              <div class="rounded-md border p-5">
                <div class="flex items-center gap-10">
                  <ImageStack images={sampleImages} />

                  <div>
                    各種SNSには、猫の画像や外出時に撮影した写真、その他趣味関連のお気に入りの画像を投稿しています。
                    外食時には、後から見返せるように食べた料理を記録しています。
                  </div>
                </div>
              </div>

              <h2>What I'm learning</h2>

              <div class="rounded-md border p-5">
                <div
                  class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
                >
                  {learning.map((entry) => <LearningCard item={entry} />)}
                </div>
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>
