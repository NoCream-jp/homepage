---
import Layout from "../layouts/Layout.astro";
// import { getCollection } from "astro:content";
import WordCloud from "../components/WordCloud.astro";
import ImageStack from "../components/ImageStack.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ActionLog from "../components/ActionLog.astro";

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";

// ImageStack用
const sampleImages = [
  "/images/cat.webp",
  "/images/atcoder.png",
  "/images/ra-men.webp",
  "/images/spotify.webp",
];

// WordCloud用
const cwords = [
  "AtCoder",
  "学園アイドルマスター",
  "東野圭吾",
  "QuizKnock",
  "星街すいせい",
  "KALDI",
  "ハリー・ポッター",
  "ポケットモンスターチャンピオンズ",
  "Spotify",
  "Arena Breakout",
  "Anker",
  "ナナホシ管弦楽団",
  "Orangestar",
  "米津玄師",
  "The Amasing Degital Circus",
];
---

<Layout title={title} description={description}>
  <div class="mx-5 mt-5 w-full max-w-5xl px-6 py-5">
    <Breadcrumbs
      items={[
        { label: "TOP", href: "/" },
        { label: "bio", href: "/bio" },
      ]}
    />

    <section class="mb-20 w-full">
      <h1 class="mb-7 text-2xl">bio</h1>
      <div class="flex flex-col items-center">
        <div class="my-5">What I saw</div>
        <div class="mb-10 flex items-center gap-15">
          <ImageStack images={sampleImages} />
          <div>
            各種SNSには猫の画像、外食の際撮影した写真、その他趣味関連の画像を投稿しています。
          </div>
        </div>

        <div class="mt-7 mb-3">Who I am</div>
        <div class="mb-10 grid grid-cols-1 gap-2 md:grid-cols-2 md:gap-8">
          <p class="text-md leading-relaxed text-zinc-900">
            こんにちは。みなとといいます。大学4回生で、AIや機械学習、ブロックチェーン、ネットワークについて学んでいます。webサイトを作ったり、競技プログラミングをしています。現在は、英語でアニメを見るのに熱中しています。寝ること、食べること、猫とお話することが好きです。どうぞよろしく。
          </p>
          <p class="text-md leading-relaxed text-zinc-900">
            Hi. I'm Minato Hayashi, a senior university student, in Japan. I'm
            learning AI, machine learning, blockchain, network, and more. I
            recently make websites and articles, participate competitive
            programming. I love eating, sleeping, and talking with cat. Have fun
            everything with me !!
          </p>
        </div>

        <div class="my-5">What I like</div>
        <WordCloud
          words={cwords}
          width="80%"
          height="250px"
          maxFont={50}
          minFont={35}
        />
        <div class="mb-10"></div>

        <div class="my-5">What I did</div>
        <div class="px-15 sm:px-20 md:px-25 lg:px-35">
          <ActionLog limit={10} />
        </div>
        <!-- <div class="mt-15 mb-5">What I listen</div> -->
      </div>
    </section>
  </div>
</Layout>
