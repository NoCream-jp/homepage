---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ActionLog from "../components/ActionLog.astro";
import ImageStack from "../components/ImageStack.astro";
import LeftNav from "../components/LeftNav.astro";
import NotificationStrip from "../components/NotificationStrip.astro";

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";

const sampleImages = [
  "/images/cat.webp",
  "/images/atcoder.png",
  "/images/ra-men.webp",
  "/images/spotify.webp",
];

const notificationItems = [
  {
    section: "blog",
    date: "2026/09/15",
    title: "最近考えていること",
    href: "/blog/20260915_diary",
    banner: false,
  },
  {
    section: "blog",
    date: "2026/09/15",
    title: "ホームページをリニューアルしました",
    href: "/blog/20260915_renew-site",
    banner: false,
  },
];
---

<Layout title={title} description={description}>
  <div class="flex h-full min-h-0 flex-col pt-10">
    <div class="flex min-h-0 flex-1 flex-col lg:flex-row">
      <!-- 左 -->
      <aside
        class="flex w-full shrink-0 flex-col gap-4 p-4 lg:w-110 lg:justify-around lg:gap-5 lg:p-5"
      >
        <LeftNav />
      </aside>

      <!-- 右 -->
      <main
        class="flex min-h-0 w-full min-w-0 flex-1 flex-col px-4 py-10 lg:px-7 lg:py-15"
      >
        <h1 class="mb-6 text-2xl font-semibold text-zinc-800">bio</h1>
        <div class="no-scrollbar flex min-h-0 flex-1 flex-col overflow-y-auto">
          <div class="w-full">
            <section class="mt-10 mb-10 flex w-full flex-col gap-4">
              <h2 class="">Who I am</h2>
              <div class="rounded-md border p-5">
                <div class="">
                  こんにちは。みなとといいます。大学4回生で、AIや機械学習、ブロックチェーン、ネットワークについて学んでいます。
                  ウェブサイトを作ったり、競技プログラミングに参加したりしています。現在は、英語でアニメを見るのに熱中しています。
                  寝ること、食べること、音楽を聴くこと、猫とお話することが好きです。美しいと思ったものはなんでも勉強します。どうぞよろしく。
                </div>
              </div>

              <h2 class="">What I saw</h2>
              <div class="rounded-md border p-5">
                <div class="flex items-center gap-10">
                  <ImageStack images={sampleImages} />
                  <div>
                    各種SNSには、猫の画像や外出時に撮影した写真、その他趣味関連のお気に入りの画像を投稿しています。
                    外食時には、後から見返せるように食べた料理を記録しています。
                  </div>
                </div>
              </div>

              <h2 class="">What I'm learning</h2>
              <div class="rounded-md border p-5">
                <div class="flex items-center gap-10"></div>
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>
