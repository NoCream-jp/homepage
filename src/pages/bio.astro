---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import WordCloud from "../components/WordCloud.astro";
import ImageStack from "../components/ImageStack.astro";

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";

// ImageStack用
const sampleImages = [
  "/images/cat.webp",
  "/images/atcoder.png",
  "/images/ra-men.webp",
  "/images/spotify.webp",
];
---

<Layout title={title} description={description}>
  <div class="mx-5 mt-5 w-full max-w-5xl px-6 py-12">
    <section class="mb-20 w-full">
      <h1 class="mb-7 text-2xl">bio</h1>
      <div class="flex flex-col items-center">
        <div class="my-5">What I saw</div>
        <ImageStack images={sampleImages} />
        <div class="h-20"></div>

        <div class="mt-15 mb-3">Who I am</div>
        <div class="mb-10 grid grid-cols-1 gap-2 md:grid-cols-2 md:gap-8">
          <p class="text-sm leading-relaxed text-zinc-900">
            こんにちは。みなとといいます。大学4回生で、AIや機械学習、ネットワークについて学んでいます。webサイトを作ったり、競技プログラミングをしています。現在は、英語でアニメを見るのに熱中しています。寝ること、食べること、猫とお話することが好きです。どうぞよろしく。
          </p>
          <p class="text-sm leading-relaxed text-zinc-900">
            Hi. I'm Minato Hayashi, a senior university student, in Japan. I'm
            learning AI, machine learning, network, and more. I recently make
            websites and articles, permit competitive programming. I love
            eating, sleeping, and talking with cat. Have fun everything with me
            !!
          </p>
        </div>

        <div class="my-5">What I like</div>
        <WordCloud
          words={[
            "AtCoder",
            "学園アイドルマスター",
            "東野圭吾",
            "QuizKnock",
            "星街すいせい",
            "KALDI",
            "ハリー・ポッター",
            "ポケットモンスターチャンピオンズ",
            "Spotify",
            "Arena Breakout",
            "Anker",
            "ナナホシ管弦楽団",
            "Orangestar",
            "米津玄師",
            "",
          ]}
          width="80%"
          height="250px"
          maxFont={65}
          minFont={35}
        />

        <div class="my-5">What I listen</div>
      </div>
    </section>
  </div>
</Layout>
