---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BuisinessCard from "../components/BuisinessCard.astro";
import LinkCard from "../components/LinkCard.astro";
import ActionLog from "../components/ActionLog.astro";
import ImageStack from "../components/ImageStack.astro";
import NotificationStrip from "../components/NotificationStrip.astro";

const title = "Minato Hayashi";
const description = "bio page";

const sampleImages = [
  "/images/cat.webp",
  "/images/atcoder.png",
  "/images/ra-men.webp",
  "/images/spotify.webp",
];

const notificationItems = [
  {
    section: "blog",
    date: "2026/09/15",
    title: "最近考えていること",
    href: "/blog/20260915_diary",
    banner: false,
  },
  {
    section: "blog",
    date: "2026/09/15",
    title: "ホームページをリニューアルしました",
    href: "/blog/20260915_renew-site",
    banner: false,
  },
];
---

<Layout title={title} description={description}>
  <NotificationStrip items={notificationItems} />
  <div class="flex min-h-0 w-full flex-1 flex-col lg:flex-row">
    <aside
      class="flex w-full shrink-0 flex-col gap-4 p-4 lg:w-110 lg:justify-around lg:gap-5 lg:p-5"
    >
      <div class="text-3xl"></div>

      <BuisinessCard
        name="Minato Hayashi"
        age="23+"
        location="Osaka, Japan"
        pronoun="He / Him"
        study="reinforcement learning"
      />

      <div class="grid w-full max-w-100 grid-cols-2 gap-1">
        <LinkCard
          title="GitHub"
          username="NoCream-jp"
          href="https://github.com/NoCream-jp"
        />
        <LinkCard
          title="X (Twitter)"
          username="Cafe"
          href="https://x.com/sXMN1au45a68174"
        />
        <LinkCard
          title="LinkedIn"
          username="Minato Hayashi"
          href="https://www.linkedin.com/in/m-hayashi/"
        />
        <LinkCard
          title="Instagram"
          href="https://www.instagram.com/koshi2055"
        />
        <LinkCard
          title="AtCoder"
          username="Caffeineholic"
          href="https://atcoder.jp/users/Caffeineholic"
        />
        <LinkCard title="occ3710@outlook.jp" disabled />
      </div>
    </aside>

    <!-- =========================
      RIGHT（bio専用2カラム）
    ========================== -->
    <main class="flex w-full flex-1 flex-col p-4 lg:min-h-0 lg:p-7">
      <Breadcrumbs
        items={[
          { label: "TOP", href: "/" },
          { label: "bio", href: "/bio" },
        ]}
      />

      <!-- 右側をさらに2分割 -->
      <div
        class="mt-10 flex w-full flex-1 flex-col gap-10 lg:flex-row lg:gap-8"
      >
        <!-- LEFT: intro + images -->
        <section class="flex flex-1 flex-col gap-8">
          <div>
            <h1 class="mb-4 text-2xl font-semibold text-zinc-800">bio</h1>

            <p class="leading-relaxed text-zinc-900">
              こんにちは。みなとです。AI・競プロ・Web開発を中心に活動しています。
              研究やシステムにも興味があります。
            </p>
          </div>

          <div class="flex items-center gap-6">
            <ImageStack images={sampleImages} />
            <p class="text-sm leading-relaxed text-zinc-700">
              猫・食事・趣味の写真を記録しています。
            </p>
          </div>
        </section>

        <!-- RIGHT: ActionLog -->
        <aside class="flex flex-1 flex-col">
          <h2 class="mb-4 text-sm text-zinc-500">Activity Log</h2>

          <div class="lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
            <ActionLog limit={10} />
          </div>
        </aside>
      </div>
    </main>
  </div>
</Layout>
