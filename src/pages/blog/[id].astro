---
// src/pages/blog/[id].astro
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BackButton from "../../components/BackButton.astro";
import Highlight from "../../components/Highlight.astro";
import LikeButton from "../../components/LikeButton.astro";
import LeftNav from "../../components/LeftNav.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props as Props;
const { Content } = await render(post);

// OGP meta (kept for Layout props)
const description =
  post.data.description || `${post.data.title}についての記事です。`;
const image = post.data.image || "/brand/ogp-image.png";

const d = post.data.date;
const formattedDate = `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getDate()).padStart(2, "0")}`;
---

<Layout title={`${post.data.title} | mi-nato.com`} description={description}>
  <div class="flex h-full min-h-0 flex-col pt-10">
    <div class="flex min-h-0 flex-1 flex-col lg:flex-row">
      <!-- 左 -->
      <aside
        class="flex w-full shrink-0 flex-col gap-4 p-4 lg:w-110 lg:justify-around lg:gap-5 lg:p-5"
      >
        <LeftNav />
      </aside>

      <!-- 右 -->
      <main
        class="flex min-h-0 w-full min-w-0 flex-1 flex-col px-4 py-7 lg:px-7 lg:py-10"
      >
        <h1 class="text-2xl font-semibold text-zinc-800">
          {post.data.title}
        </h1>

        <span class="mb-1 text-zinc-500">{formattedDate}</span>

        <!-- 本文のみスクロール -->
        <div
          class="no-scrollbar flex min-h-0 flex-1 overflow-y-auto rounded-md border px-7"
        >
          <div class="w-full">
            <section class="w-full pb-10">
              <article
                class="blog-content text-[15px] leading-normal tracking-wide text-zinc-800 md:text-base"
              >
                <Content components={{ Highlight }} />
              </article>
            </section>
          </div>
        </div>

        <!-- フッター-->
        <div class="mt-2 flex w-full items-center justify-between">
          <BackButton href="/blog" />
          <LikeButton articleId={post.id} />
        </div>
      </main>
    </div>
  </div>
</Layout>

<style>
  :global(.blog-content p) {
    margin-bottom: 0.5rem;
  }

  :global(.blog-content a) {
    color: #52525b;
    text-decoration: underline;
    text-decoration-color: #18181b;
    text-underline-offset: 4px;
    transition: all 0.2s ease;
  }
  :global(.blog-content a:hover) {
    color: #a0a0a0;
    text-decoration-color: #d4d4d8;
  }
  :global(.blog-content h2) {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1.2rem;
  }
  :global(.blog-content h3) {
    font-size: 1.1rem;
    font-weight: 500;
    margin-top: 1.5rem;
    margin-bottom: 1.1rem;
  }
  :global(.blog-content ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 2rem;
  }

  /* テーブル全体 */
  :global(.blog-content table) {
    width: 100%;
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;

    display: block;
    overflow-x: auto;
    white-space: nowrap;
  }

  :global(.blog-content th) {
    width: 100%;
    font-weight: 500;
    color: #27272a;
    padding: 0.8rem 1rem;
    text-align: left;
    background-color: white;
  }

  :global(.blog-content td) {
    padding: 0.8rem 1rem;
  }

  /* スクロールバーの見た目（任意） */
  :global(.no-scrollbar::-webkit-scrollbar) {
    width: 8px;
    height: 8px;
  }
  :global(.no-scrollbar::-webkit-scrollbar-thumb) {
    background: rgba(0, 0, 0, 0.08);
    border-radius: 999px;
  }
</style>
