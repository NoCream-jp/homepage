---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BackButton from "../../components/BackButton.astro";
import Highlight from "../../components/Highlight.astro";
import LikeButton from "../../components/LikeButton.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => {
    return data.draft !== true;
  });
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

// OGP
const description =
  post.data.description || `${post.data.title}についての記事です。`;
const image = post.data.image || "/brand/ogp-image.png";
---

<Layout title={`${post.data.title} | mi-nato.com`} description={description}>
  <div class="mx-auto my-8 w-full max-w-3xl px-4 md:px-6">
    <article class="mb-10">
      <Breadcrumbs
        items={[
          { label: "TOP", href: "/" },
          { label: "blog", href: "/blog" },
          { label: post.data.title },
        ]}
      />

      <header class="mt-10 mb-10">
        <div class="border-b border-zinc-300 pb-5">
          <h1
            class="text-xl font-bold tracking-wide text-zinc-800 md:text-[1.7rem]"
          >
            {post.data.title}
          </h1>
        </div>
      </header>

      <div
        class="blog-content text-[15px] leading-normal tracking-wide text-zinc-800 md:text-base"
      >
        <Content components={{ Highlight }} />
      </div>
    </article>

    <div class="article-footer flex w-full items-center justify-between">
      <BackButton href="/blog" />
      <LikeButton articleId={post.id} />
    </div>
  </div>
</Layout>

<style>
  :global(.blog-content p) {
    margin-bottom: 0.5rem;
  }

  :global(.blog-content a) {
    color: #52525b;
    text-decoration: underline;
    text-decoration-color: #18181b;
    text-underline-offset: 4px;
    transition: all 0.2s ease;
  }
  :global(.blog-content a:hover) {
    color: #a0a0a0;
    text-decoration-color: #d4d4d8;
  }
  :global(.blog-content h2) {
    font-size: 1.2rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 1.2rem;
  }
  :global(.blog-content h3) {
    font-size: 1.1rem;
    font-weight: 400;
    margin-top: 1.5rem;
    margin-bottom: 1.1rem;
  }
  :global(.blog-content ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 2rem;
  }

  /* テーブル全体 */
  :global(.blog-content table) {
    width: 100%;
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;

    display: block;
    overflow-x: auto;
    white-space: nowrap;
  }

  /* テーブルヘッダー（h1の下線と同じ色で統一感を持たせる） */
  :global(.blog-content th) {
    width: 100%;
    font-weight: 500; /* h2と同じ太さで統一 */
    color: #27272a; /* text-zinc-800 */
    padding: 0.8rem 1rem;
    text-align: left;
    background-color: white;
  }

  /* テーブルデータ（控えめな細いラインで区切る） */
  :global(.blog-content td) {
    padding: 0.8rem 1rem;
  }
</style>
