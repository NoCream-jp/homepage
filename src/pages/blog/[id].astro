---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

// 1. ビルド時に「どのURL（パス）を生成するか」をAstroに教える必須の関数
export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { id: post.id }, // URLの一部になるID（Astro 5以降の仕様）
    props: { post }, // ページに渡す記事データそのもの
  }));
}

// 2. 上の関数から渡された記事データを受け取る
const { post } = Astro.props;

// 3. Markdownの本文をHTMLに変換する（Astro 5の新しい書き方）
const { Content } = await render(post);

// 日付のフォーマット（BlogItemと同じく美しく）
const formattedDate = post.data.date
  .toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  })
  .replace(/\//g, ".");
---

<!-- サイト全体のレイアウトで包む（タイトルには記事のタイトルを入れる） -->
<Layout title={`${post.data.title} | Minato`}>
  <main class="md:pr-sidebar min-h-screen bg-white px-6 py-32 md:px-12">
    <article class="mx-auto w-full max-w-3xl">
      <!-- 記事のヘッダー情報（極限までシンプルに） -->
      <header class="mb-8 border-b border-black/10 pb-8">
        <time class="text-label mb-4 block text-sm tracking-widest">
          {formattedDate}
        </time>
        <h1 class="text-3xl leading-relaxed font-bold text-black md:text-4xl">
          {post.data.title}
        </h1>
      </header>
      <div
        class="blog-content space-y-6 text-base leading-loose text-black md:text-lg"
      >
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  /* 
   * Markdownコンテンツ用のスタイリング 
   * :global() を使うことで、Astroが生成した子要素（Content内）にもスタイルを当てられます
   */

  /* リンク（URL）: global.cssで定義されているテーマカラーを適用 */
  :global(.blog-content a) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-link) 40%,
      transparent
    );
    transition: all 0.2s ease;
  }
  :global(.blog-content a:hover) {
    text-decoration-color: var(--color-link);
    text-decoration-thickness: 2px;
  }

  /* h2: 大きめの見出し（下線付き） */
  :global(.blog-content h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
  }

  /* h3: 中くらいの見出し */
  :global(.blog-content h3) {
    font-size: 1.3rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
  }

  /* 段落とリストにも適切な余白を追加（必要に応じて） */
  :global(.blog-content p) {
    margin-bottom: 1.5rem;
  }
  :global(.blog-content ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  :global(.blog-content ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  :global(.blog-content li) {
    margin-bottom: 0.5rem;
  }
</style>
