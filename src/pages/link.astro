---
import Layout from "../layouts/Layout.astro";
import LinkCard from "../components/LinkCard.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<Layout>
  <div class="mx-5 mt-5 w-full max-w-5xl px-6 py-5">
    <Breadcrumbs
      items={[
        { label: "TOP", href: "/" },
        { label: "link", href: "/link" },
      ]}
    />

    <section class="my-10 w-full">
      <h2 class="mb-7 text-2xl font-normal">links</h2>

      <div class="grid w-full grid-cols-3 gap-3">
        <LinkCard
          title="GitHub"
          username="NoCream-jp"
          href="https://github.com/NoCream-jp"
        />
        <LinkCard
          title="X"
          username="Cafe"
          href="https://x.com/sXMN1au45a68174"
        />
        <LinkCard
          title="LinkedIn"
          username="Minato Hayashi"
          href="https://www.linkedin.com/in/m-hayashi/"
        />
        <LinkCard
          title="Instagram"
          href="https://www.instagram.com/koshi2055"
        />
        <LinkCard
          title="AtCoder"
          username="Caffeineholic"
          href="https://atcoder.jp/users/Caffeineholic"
        />
        <LinkCard
          title="Qiita"
          username="_NoCream"
          href="https://qiita.com/_NoCream"
        />
      </div>
    </section>
  </div>
</Layout>
