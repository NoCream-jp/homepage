---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArticleCardList from "../components/ArticleCardList.astro";
import TagFilter from "../components/TagFilter.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";

/* 記事 */
const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = Array.from(
  new Set(posts.flatMap((p) => p.data.tags ?? []))
).sort();
---

<Layout title={title} description={description}>
  <div class="mx-auto mt-8 w-full max-w-3xl px-4 md:px-6">
    <Breadcrumbs
      items={[
        { label: "TOP", href: "/" },
        { label: "blog", href: "/blog" },
      ]}
    />

    <section class="mt-10 mb-10 w-full">
      <h1 class="mb-6 text-2xl font-semibold text-zinc-800">all blogs</h1>

      <!-- タグフィルター -->
      <div class="mb-6 flex w-full shrink-0 justify-end">
        <TagFilter tags={allTags} selector=".post-item" />
      </div>

      <!-- 一覧 -->
      <div class="relative w-full">
        <ArticleCardList posts={posts} />
      </div>
    </section>
  </div>
</Layout>
