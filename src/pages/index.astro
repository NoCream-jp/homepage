---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";
---

<Layout title={title} description={description}>
  <!-- ティッカー・区切り線領域 -->
  <div
    class="flex h-10 w-full items-center overflow-hidden border-y px-4 text-xs text-zinc-600"
  >
    <span class="mr-4 text-zinc-400">blog</span>
    <span class="mr-4">2026/09/09/08</span>
    <span class="mr-8">ハッカソンに出場してきました →</span>
  </div>

  <div class="mx-auto max-w-5xl px-6 py-12">
    <!-- blogセクション -->
    <section class="mb-20 w-full">
      <h2 class="mb-8 text-2xl font-normal">blog</h2>
      <div
        class="grid w-full grid-cols-2 gap-3 md:grid-cols-3 md:gap-5 lg:grid-cols-4 lg:gap-6"
      >
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    </section>

    <!-- bioセクション -->
    <section class="w-full">
      <h2 class="mb-8 text-2xl font-normal">bio</h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <p class="text-sm leading-relaxed text-zinc-900">
          こんにちは。みなとといいます。大学4回生で、AIや機械学習、ネットワークについて学んでいます。webサイトを作ったり、競技プログラミングをしています。現在は、英語でアニメを見るのに熱中しています。寝ること、食べること、猫とお話しすることが好きです。どうぞよろしく。
        </p>
        <p class="text-sm leading-relaxed text-zinc-900">
          Hi. I'm Minato Hayashi, a senior university student, in Japan. I'm
          learning AI, machine learning, network, and more. I recently make
          websites and articles, permit competitive programming. I love eating,
          sleeping, and talking with cat. Have fun everything!
        </p>
      </div>
    </section>
  </div>
</Layout>
