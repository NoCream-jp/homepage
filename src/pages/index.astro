---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArticleCardList from "../components/ArticleCardList.astro";
import BuisinessCard from "../components/BuisinessCard.astro";
import LinkCard from "../components/LinkCard.astro";
import TagFilter from "../components/TagFilter.astro";
import NotificationStrip from "../components/NotificationStrip.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = Array.from(
  new Set(posts.flatMap((p) => p.data.tags ?? []))
).sort();

const notificationItems = [
  {
    section: "blog",
    date: "2026/09/17",
    title: "ホームページをリニューアルしました",
    href: "/blog/20260915_renew-site",
    banner: false,
  },
];

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";
---

<Layout title={title} description={description}>
  <NotificationStrip items={notificationItems} />
  <div class="flex h-full min-h-0 w-full flex-1">
    <!-- 左 -->
    <aside class="flex h-full flex-col justify-around gap-5 p-5">
      <BuisinessCard />

      <div class="grid grid-cols-2 gap-1">
        <LinkCard
          title="GitHub"
          username="NoCream-jp"
          href="https://github.com/NoCream-jp"
        />
        <LinkCard
          title="X"
          username="Cafe"
          href="https://x.com/sXMN1au45a68174"
        />
        <LinkCard
          title="LinkedIn"
          username="Minato Hayashi"
          href="https://www.linkedin.com/in/m-hayashi/"
        />
        <LinkCard
          title="Instagram"
          href="https://www.instagram.com/koshi2055"
        />
        <LinkCard
          title="AtCoder"
          username="Caffeineholic"
          href="https://atcoder.jp/users/Caffeineholic"
        />
        <LinkCard
          title="Qiita"
          username="_NoCream"
          href="https://qiita.com/_NoCream"
        />
      </div>
    </aside>

    <!-- 右 -->
    <main class="flex min-h-0 w-full flex-1 flex-col items-stretch p-7">
      <div class="w-full shrink-0 p-3">
        <TagFilter tags={allTags} selector=".post-item" />
      </div>

      <div class="relative min-h-0 flex-1">
        <div class="no-scrollbar h-full overflow-y-auto py-3">
          <ArticleCardList posts={posts} />
        </div>

        <!-- <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-20 z-10 bg-linear-to-t from-white to-transparent" /> -->
      </div>
    </main>
  </div>
</Layout>
