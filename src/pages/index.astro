---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArticleCardList from "../components/ArticleCardList.astro";
import BuisinessCard from "../components/BuisinessCard.astro";
import LinkCard from "../components/LinkCard.astro";
import TagFilter from "../components/TagFilter.astro";
import NotificationStrip from "../components/NotificationStrip.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = Array.from(
  new Set(posts.flatMap((p) => p.data.tags ?? []))
).sort();

const notificationItems = [
  {
    section: "blog",
    date: "2026/09/17",
    title: "ホームページをリニューアルしました",
    href: "/blog/20260915_renew-site",
    banner: false,
  },
];

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";
---

<Layout title={title} description={description}>
  <NotificationStrip items={notificationItems} />
  <div class="flex h-full min-h-0 w-full flex-1">
    <!-- 左 -->
    <aside class="flex h-full flex-col justify-around gap-5 p-5">
      <BuisinessCard
        name="Minato Hayashi"
        age="23+"
        location="Osaka, Japan"
        pronoun="He / Him"
        study="reinforcement learning"
      />

      <div class="grid grid-cols-2 gap-1">
        <LinkCard
          title="GitHub"
          username="NoCream-jp"
          href="https://github.com/NoCream-jp"
        />
        <LinkCard
          title="X"
          username="Cafe"
          href="https://x.com/sXMN1au45a68174"
        />
        <LinkCard
          title="LinkedIn"
          username="Minato Hayashi"
          href="https://www.linkedin.com/in/m-hayashi/"
        />
        <LinkCard
          title="Instagram"
          href="https://www.instagram.com/koshi2055"
        />
        <LinkCard
          title="AtCoder"
          username="Caffeineholic"
          href="https://atcoder.jp/users/Caffeineholic"
        />
        <LinkCard
          title="Qiita"
          username="_NoCream"
          href="https://qiita.com/_NoCream"
        />
      </div>
    </aside>

    <!-- 右 -->
    <main class="flex min-h-0 w-full flex-1 flex-col items-stretch p-7">
      <div class="flex h-fit w-full shrink-0 justify-end p-3"> 
        <TagFilter tags={allTags} selector=".post-item" />
      </div>

      <div class="relative min-h-0 flex-1">
        <!-- 上スクロールボタン -->
        <button
          id="scroll-up-btn"
          class="group absolute top-4 left-1/2 z-10 flex h-6 w-20 -translate-x-1/2 cursor-pointer items-center justify-center rounded-full border bg-white transition hover:border-zinc-500"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="h-4 w-4 text-black transition group-hover:text-zinc-500"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M18 15l-6-6-6 6"></path>
          </svg>
        </button>

        <!-- スクロール本体 -->
        <div
          id="post-scroll"
          class="no-scrollbar h-full overflow-y-auto pt-3 pb-10"
        >
          <ArticleCardList posts={posts} />
        </div>

        <!-- 下スクロールボタン -->
        <button
          id="scroll-down-btn"
          class="group absolute bottom-4 left-1/2 z-10 flex h-6 w-20 -translate-x-1/2 cursor-pointer items-center justify-center rounded-full border bg-white transition hover:border-zinc-500"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="transtion h-4 w-4 text-black group-hover:text-zinc-500"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 9l6 6 6-6"></path>
          </svg>
        </button>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  const scroll = document.getElementById("post-scroll");
  const downBtn = document.getElementById("scroll-down-btn");
  const upBtn = document.getElementById("scroll-up-btn");

  if (scroll && downBtn && upBtn) {
    // 下へ
    downBtn.addEventListener("click", () => {
      scroll.scrollBy({ top: 200, behavior: "smooth" });
    });

    // 上へ
    upBtn.addEventListener("click", () => {
      scroll.scrollBy({ top: -200, behavior: "smooth" });
    });

    const update = () => {
      const top = scroll.scrollTop;
      const max = scroll.scrollHeight - scroll.clientHeight;

      // 上ボタン
      const isTop = top <= 5;
      upBtn.style.opacity = isTop ? "0" : "1";
      upBtn.style.pointerEvents = isTop ? "none" : "auto";

      // 下ボタン
      const isBottom = top >= max - 5;
      downBtn.style.opacity = isBottom ? "0" : "1";
      downBtn.style.pointerEvents = isBottom ? "none" : "auto";
    };

    scroll.addEventListener("scroll", update);
    update();
  }
</script>
