---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArticleCardList from "../components/ArticleCardList.astro";
import LeftNav from "../components/LeftNav.astro";
import NotificationStrip from "../components/NotificationStrip.astro";
import ViewMoreButton from "../components/ViewMoreButton.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const latestPosts = posts.slice(0, 5);

const notificationItems = [
  {
    section: "blog",
    date: "2026/09/15",
    title: "最近考えていること",
    href: "/blog/20260915_diary",
    banner: false,
  },
  {
    section: "blog",
    date: "2026/09/15",
    title: "ホームページをリニューアルしました",
    href: "/blog/20260915_renew-site",
    banner: false,
  },
];

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";
---

<Layout title={title} description={description}>
  <div class="flex h-full min-h-0 flex-col pt-10">
    <!-- NotificationStripより下 -->
    <div class="flex min-h-0 flex-1 flex-col lg:flex-row">
      <!-- 左 -->
      <aside
        class="flex w-full shrink-0 flex-col gap-4 p-4 lg:w-110 lg:justify-around lg:gap-5 lg:p-5"
      >
        <LeftNav />
      </aside>

      <!-- 右 -->
      <main class="flex min-h-0 w-full min-w-0 flex-1 flex-col p-4 lg:p-7">
        <!-- ここだけスクロール可能 -->
        <div class="no-scrollbar flex min-h-0 flex-1 flex-col overflow-y-auto">
          <!-- 下：最新記事 -->
          <section class="mt-10 w-full lg:mt-auto lg:pt-10">
            <ArticleCardList posts={latestPosts} />

            <div class="mt-4 flex justify-end">
              <ViewMoreButton href="/blog" />
            </div>
          </section>
        </div>
      </main>
    </div>
  </div>
</Layout>
