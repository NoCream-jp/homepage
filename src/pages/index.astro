---
import Layout from "../layouts/Layout.astro";
import NewsItem from "../components/NewsItem.astro";
import ViewMore from "../components/ViewMore.astro";
import BlogItem from "../components/BlogItem.astro";
import ActionAccordion from "../components/ActionAccordion.astro";

import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.date.valueOf() - a.data.date.valueOf()
);

const allNews = await getCollection("news");
const sortedNews = allNews.sort(
  (a: CollectionEntry<"news">, b: CollectionEntry<"news">) =>
    b.data.date.valueOf() - a.data.date.valueOf()
);

const allActions = await getCollection("action");
const sortedActions = allActions.sort(
  (a: CollectionEntry<"action">, b: CollectionEntry<"action">) =>
    b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Home">
  <section id="top" class="mb-60 flex h-screen flex-col justify-end bg-white">
    <div class="">
      <h1 class="font-sans text-9xl font-bold">I'm <br />Minato</h1>
    </div>
  </section>

  <section
    id="news"
    class="scroll-mt-header mb-40 h-auto bg-white p-10 md:scroll-mt-0 lg:p-15"
  >
    <div class="section-header mb-20">
      <h2 class="font-sans text-5xl font-bold">News</h2>
    </div>
    <div class="main-container md:mr-20 md:px-10 lg:px-20 lg:pr-50">
      {
        sortedNews.map((item) => (
          <NewsItem
            date={item.data.date}
            title={item.data.title}
            href={item.data.href}
          />
        ))
      }
    </div>
    <div class="section-footer mt-8 flex justify-start md:px-10 lg:px-20">
      <!-- 現時点でsection-fotterはmain-containerと手動で横幅をそろえている -->
      <ViewMore href="/about" />
    </div>
  </section>

  <section
    id="about"
    class="scroll-mt-header mb-40 h-auto bg-white p-10 md:scroll-mt-0 lg:p-15"
  >
    <div class="section-header mb-20">
      <h2 class="text-5xl font-bold">About</h2>
    </div>
    <div class="main-container text-center text-3xl md:px-10 lg:px-20">
      Hi, I'm Minato. I'm a student at Wakayama University, where I'm
      researching machine learning. In my free time, I like building web apps
      and joining competitive programming contests. Lately, I've been really
      focusing on studying English!
    </div>
    <div class="section-footer mt-8 flex justify-start md:px-10 lg:px-20">
      <ViewMore href="/about" />
    </div>
  </section>

  <section
    id="blog"
    class="scroll-mt-header mb-40 h-auto bg-white p-10 md:scroll-mt-0 lg:p-15"
  >
    <div class="section-header mb-20">
      <h2 class="text-5xl font-bold">Blog</h2>
    </div>
    <div class="main-container sm:px-5 md:px-10 lg:px-20">
      {
        sortedPosts.map((post) => (
          <BlogItem
            date={post.data.date}
            title={post.data.title}
            href={`/blog/${post.id}`}
          />
        ))
      }
    </div>
    <div class="section-footer mt-8 flex justify-start md:px-10 lg:px-20">
      <ViewMore href="/about" />
    </div>
  </section>

  <section
    id="action"
    class="scroll-mt-header mb-40 h-screen bg-white p-10 md:scroll-mt-0 lg:p-15"
  >
    <div class="section-header mb-20">
      <h2 class="text-5xl font-bold">Action</h2>
    </div>
    <div class="main-container md:px-10 lg:px-20">
      <div class="">
        {
          sortedActions.map(async (action) => {
            const { Content } = await render(action);
            return (
              <ActionAccordion
                date={action.data.date}
                title={action.data.title}
              >
                <Content />
              </ActionAccordion>
            );
          })
        }
      </div>
    </div>
    <div class="section-footer mt-8 flex justify-start md:px-10 lg:px-20">
      <ViewMore href="/action" />
    </div>
  </section>
  <footer id="footer" class="flex flex-col mt-header justify-between h-screen bg-blue-100">
    <div>
      <div class="flex flex-col">
        <a href="">link</a>
        <a href="">link</a>
        <a href="">link</a>
        <a href="">link</a>
      </div>
    </div>
    <div class="flex justify-between">
      <div>© 2025-2026 mi-nato</div>
      <div>
        link link
      </div>
    </div>
  </footer>
</Layout>
