---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import NotificationStrip from "../components/NotificationStrip.astro";
import WordCloud from "../components/WordCloud.astro";
import ViewMoreButton from "../components/ViewMoreButton.astro";
import BuisinessCard from "../components/BuisinessCard.astro";
import LinkCard from "../components/LinkCard.astro";
import Link from "./link.astro";

// 通知帯
const latestItems = [
  {
    section: "blog",
    date: "2026/09/15",
    title: "最近考えていること",
    href: "/blog/20260915_diary",
  },
  {
    section: "blog",
    date: "2026/09/09",
    title: "ホームページをリニューアルしました",
    href: "/blog/20260909_renew-site",
  },
];

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentPosts = posts.slice(0, 12);

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";
---

<Layout title={title} description={description}>
  <!-- <NotificationStrip items={latestItems} /> -->
  <div class="p-auto grid h-full w-full grid-cols-[auto_1fr] gap-5">
    <!-- 左 -->
    <div
      class="flex h-full w-full max-w-xl flex-col items-center justify-around bg-red-50 p-5"
    >
      <!-- 左上 -->
      <div class="flex w-full flex-col items-center bg-white">
        <BuisinessCard />
      </div>

      <!-- 左下 -->
      <div class="grid w-full grid-cols-2 gap-1">
        <!-- 横幅をBuisinessCardと合わせる -->
        <LinkCard
          title="GitHub"
