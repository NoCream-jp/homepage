---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import NotificationStrip from "../components/NotificationStrip.astro";
import WordCloud from "../components/WordCloud.astro";
import BuisinessCard from "../components/BuisinessCard.astro";

// 通知帯
const latestItems = [
  {
    section: "blog",
    date: "2026/09/09",
    title: "ホームページをリニューアルしました",
    href: "/blog/renew-site",
  },
  {
    section: "work",
    date: "2026/07/06",
    title: "ICPCに参加してきました",
    href: "/blog/icpc2026",
  },
];

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const title = "Minato Hayashi";
const description = "Minato Hayashi's portfolio and blog";
---

<Layout title={title} description={description}>
  <NotificationStrip items={latestItems} />

  <div class="mx-auto mt-5 max-w-5xl px-6 py-12">
    <!-- blogセクション -->
    <section class="mb-20 w-full">
      <h2 class="mb-7 text-2xl font-normal">blog</h2>
      <div
        class="grid w-full grid-cols-2 gap-3 md:grid-cols-3 md:gap-5 lg:grid-cols-4 lg:gap-6"
      >
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    </section>

    <!-- bioセクション -->
    <section class="mb-20 w-full">
      <h2 class="mb-7 text-2xl font-normal">bio</h2>
      <div class="flex flex-col items-center">
        <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
          <p class="text-sm leading-relaxed text-zinc-900">
            こんにちは。みなとといいます。大学4回生で、AIや機械学習、ネットワークについて学んでいます。webサイトを作ったり、競技プログラミングをしています。現在は、英語でアニメを見るのに熱中しています。寝ること、食べること、猫とお話することが好きです。どうぞよろしく。
          </p>
          <p class="text-sm leading-relaxed text-zinc-900">
            Hi. I'm Minato Hayashi, a senior university student, in Japan. I'm
            learning AI, machine learning, network, and more. I recently make
            websites and articles, permit competitive programming. I love
            eating, sleeping, and talking with cat. Have fun everything with me
            !!
          </p>
        </div>
        <WordCloud
          words={[
            "AtCoder",
            "学園アイドルマスター",
            "東野圭吾",
            "QuizKnock",
            "星街すいせい",
            "KALDI",
            "ハリーポッター",
            "ポケットモンスターチャンピオンズ",
          ]}
          width="80%"
          height="150px"
          maxFont={150}
          minFont={50}
        />
      </div>
    </section>

    <!-- workセクション -->
    <section class="w-full">
      <h2 class="mb-7 text-2xl font-normal">work</h2>

      work in progress...
    </section>
  </div>
</Layout>
