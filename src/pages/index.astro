---
import Layout from "../layouts/Layout.astro";
import NewsItem from "../components/NewsItem.astro";
---

<Layout title="Home">
  <section id="top" class="mb-60 flex h-screen flex-col justify-end bg-white">
    <div class="">
      <h1 class="font-sans text-9xl font-bold">I'm <br />Minato</h1>
    </div>
  </section>

  <section
    id="news"
    class="scroll-mt-header mb-40 h-screen bg-white px-20 py-10 lg:scroll-mt-0"
  >
    <div class="">
      <h2 class="font-sans text-5xl font-bold">News</h2>
    </div>
    <div class="flex-col">
      <NewsItem date={"2026/05/10"} title={"temp"} href="/" />
      <NewsItem date={"2026/05/10"} title={"temp"} href="/" />
    </div>
  </section>
  <section
    id="about"
    class="scroll-mt-header mb-40 h-screen bg-white px-20 py-10 lg:scroll-mt-0"
  >
    <div class="">
      <h2 class="text-5xl font-bold">About</h2>
    </div>
  </section>
  <section
    id="blog"
    class="scroll-mt-header mb-40 h-screen bg-white px-20 py-10 lg:scroll-mt-0"
  >
    <div class="">
      <h2 class="text-5xl font-bold">Blog</h2>
    </div>
  </section>
  <section
    id="work"
    class="scroll-mt-header mb-40 h-screen bg-white px-20 py-10 lg:scroll-mt-0"
  >
    <div class="">
      <h2 class="text-5xl font-bold">Work</h2>
    </div>
  </section>
</Layout>
