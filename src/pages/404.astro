---
import Layout from "../layouts/Layout.astro";
const pathname = Astro.url.pathname;

const navigation = [
  { label: "home", href: "/" },
  { label: "blog", href: "/blog" },
  { label: "bio", href: "/bio" },
  { label: "work", href: "/work" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<Layout>
  <div
    class="px-20 justify-center flex items-center w-full min-w-0 flex-col gap-10"
  >
    <h1
      data-404-equation
      class="text-[clamp(2.5rem,10vw,8rem)] leading-none font-semibold whitespace-nowrap"
    >
      1 + 403 = 404
    </h1>

    <h2 class="text[2rem]">
      Looks like you're in the wrong place. Click below to go to the right page.
    </h2>

    <nav
      class="flex w-full max-w-100 items-center gap-1"
      aria-label="page navigation"
    >
      {
        navigation.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex-1 rounded-md border px-2 py-2 text-center text-sm transition-colors",
                active
                  ? "bg-primary text-inverse border-transparent"
                  : "bg-surface text-secondary hover:border-accent hover:text-accent border-(--site-border)",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</Layout>

<script is:inline data-astro-rerun>
  const equation = document.querySelector("[data-404-equation]");

  if (equation) {
    const firstNumber = Math.floor(Math.random() * 403) + 1;
    equation.textContent = `${firstNumber} + ${404 - firstNumber} = 404`;
  }
</script>
