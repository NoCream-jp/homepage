---
import "../styles/global.css";
import ExternalLink from "../components/ExternalLink.astro";

const { title = "Minato Hayashi", description = "my portfolio / blog" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="flex w-full justify-between p-6">
      <div class="flex flex-col">
        <a href="/" class="display-none hidden font-sans text-2xl sm:block"
          >Minato Hayashi</a
        >
        <a href="/" class="block font-sans text-2xl sm:hidden">TOP</a>
      </div>
      <nav class="flex w-1/4 items-center justify-end gap-7 text-xl">
        <a href="/blog">blog</a>
        <a href="/bio">bio</a>
        <a href="/">work</a>
      </nav>
    </header>

    <main class="flex w-full flex-col items-center">
      <slot />
    </main>

    <footer class="flex flex-col items-center w-full border-t">
      <div class="mx-5 mt-5 max-w-5xl p-6 w-full">
        <div class="items-left flex w-full flex-col">
          <ExternalLink href="/" text="GitHub" />
          <ExternalLink href="/" text="X" />
          <ExternalLink href="/" text="AtCoder" />
        </div>
        <div class="mt-5">
          Minato Hayashi © {new Date().getFullYear()}
        </div>
      </div>
    </footer>
  </body>
</html>
