---
import "katex/dist/katex.min.css"; // 数式レンダリングのために katex インポート
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import NotificationStrip from "../components/NotificationStrip.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Minato Hayashi", description = "my portfolio / blog" } =
  Astro.props;

const notificationItems = [
  {
    section: "cli",
    date: "2026/10/18",
    title: "CLI版ページを作成しました",
    href: "/cli",
    banner: false,
  },
  {
    section: "bio",
    date: "2026/10/20",
    title: "bioページが新しくなりました",
    href: "/bio",
    banner: false,
  },
];
---

<!doctype html>
<html lang="ja" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <script is:inline data-astro-rerun>
      (() => {
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
          .matches
          ? "dark"
          : "light";

        try {
          const savedTheme = localStorage.getItem("theme");
          document.documentElement.dataset.theme =
            savedTheme === "light" || savedTheme === "dark"
              ? savedTheme
              : systemTheme;
        } catch {
          document.documentElement.dataset.theme = systemTheme;
        }
      })();
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- RSSフィード -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="mi-nato.com RSS"
      href="/rss.xml"
    />

    <ClientRouter />
  </head>

  <body class="flex min-h-screen flex-col lg:h-screen lg:overflow-hidden">
    <div class="w-full">
      <NotificationStrip items={notificationItems} />
    </div>
    <main class="flex-1 lg:min-h-0 lg:overflow-hidden">
      <slot />
    </main>

    <footer class="flex h-15 shrink-0 items-center justify-center border-t">
      <p class="text-xs text-zinc-500">
        © Copyright 2025-{new Date().getFullYear()} Minato Hayashi
      </p>
    </footer>
  </body>
</html>
