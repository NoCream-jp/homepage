---
import "../styles/global.css";
const { title = "mi-nato.com", description = "ブログサイト" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <header class="flex w-full justify-between p-3">
      <div>
        <a href="/" class="hidden text-2xl sm:block">Minato Hayashi</a>
      </div>
      <nav class="flex w-full items-center justify-around sm:w-1/4">
        <a href="">blog</a>
        <a href="">bio</a>
        <a href="">work</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div>
        <div>© {new Date().getFullYear()}</div>
      </div>
    </footer>
  </body>
</html>
