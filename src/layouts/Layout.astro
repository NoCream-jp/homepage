---
import "../styles/global.css";
import ExternalLink from "../components/ExternalLink.astro";
import ViewMoreButton from "../components/ViewMoreButton.astro";

const pathname = Astro.url.pathname;

const { title = "Minato Hayashi", description = "my portfolio / blog" } =
  Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-white font-sans">
    <header class="">
      <div class="mx-auto flex items-center justify-between px-6 py-6">
        <div class="flex items-center">
          <a href="/" class="hidden text-2xl sm:block">Minato Hayashi</a>
          <a href="/" class="block text-lg sm:hidden">TOP</a>
        </div>
        <nav aria-label="main-navigation">
          <ul class="flex items-center gap-7 text-lg">
            <li><a href="/blog" class="hover:text-zinc-500">blog</a></li>
            <li><a href="/bio" class="hover:text-zinc-500">bio</a></li>
            <!-- <li><a href="/" class="">work</a></li> -->
          </ul>
        </nav>
      </div>
    </header>

    <main class="w-full">
      <div class="mx-auto flex flex-col items-center">
        <slot />
      </div>

      <footer class="mt-5 w-full border-t">
        <div class="mx-auto max-w-5xl px-6">
          <div class="flex items-center justify-between py-9">
            <!-- 左 -->
            {
              pathname !== "/link" && (
                <nav class="flex flex-col items-start gap-1 text-sm">
                  <ExternalLink
                    href="https://github.com/NoCream-jp"
                    text="GitHub"
                  />
                  <ExternalLink href="https://x.com/sXMN1au45a68174" text="X" />
                  <ExternalLink
                    href="https://atcoder.jp/users/Caffeineholic"
                    text="AtCoder"
                  />
                </nav>
              )
            }

            <!-- 中央 -->
            <div class="flex-1 text-center text-sm text-zinc-500">
              Minato Hayashi © {new Date().getFullYear()}
            </div>

            <!-- 右 -->
            {
              pathname !== "/link" && (
                <div class="group flex items-center justify-end hover:text-zinc-500">
                  <a
                    href="/link"
                    class="group-hover:text-primary inline-flex items-center gap-2 text-sm tracking-wide"
                  >
                    all links
                    <span class="inline-flex items-center justify-center rounded-full border-none p-1">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4 group-hover:text-zinc-500"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14" />
                        <path d="M12 5l7 7-7 7" />
                      </svg>
                    </span>
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </footer>
    </main>
  </body>
</html>
