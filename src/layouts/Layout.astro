---
import "../styles/global.css";
const { title = "mi-nato.com", description = "ブログサイト" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans">
    <header class="flex w-full justify-between p-3">
      <div>
        <a href="/" class="hidden font-sans text-2xl sm:block">Minato Hayashi</a
        >
      </div>
      <nav class="flex w-full items-center justify-around text-xl sm:w-1/4">
        <a href="">blog</a>
        <a href="">bio</a>
        <a href="">work</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div>
        <div>© {new Date().getFullYear()}</div>
      </div>
    </footer>
  </body>
</html>
