---
import "../styles/global.css";
import ExternalLink from "../components/ExternalLink.astro";

const { title = "Minato Hayashi", description = "my portfolio / blog" } =
  Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-white font-sans">
    <header class="">
      <div class="mx-auto flex items-center justify-between px-6 py-6">
        <div class="flex items-center">
          <a href="/" class="hidden text-2xl sm:block">Minato Hayashi</a>
          <a href="/" class="block text-lg sm:hidden">TOP</a>
        </div>
        <nav aria-label="main-navigation">
          <ul class="flex items-center gap-7 text-lg">
            <li><a href="/blog" class="hover:text-zinc-500">blog</a></li>
            <li><a href="/bio" class="hover:text-zinc-500">bio</a></li>
            <!-- <li><a href="/" class="">work</a></li> -->
          </ul>
        </nav>
      </div>
    </header>

    <main class="w-full">
      <div class="mx-auto flex flex-col items-center">
        <slot />
      </div>

      <footer class="w-full border-t py-7">
        <div class="mx-auto flex max-w-5xl flex-col items-center px-6">
          <div class="flex w-full flex-col items-start">
            <ExternalLink href="/" text="GitHub" />
            <ExternalLink href="/" text="X" />
            <ExternalLink href="/" text="AtCoder" />
          </div>

          <div class="mt-5 w-full text-left text-sm text-zinc-600">
            Minato Hayashi © {new Date().getFullYear()}
          </div>
        </div>
      </footer>
    </main>
  </body>
</html>
