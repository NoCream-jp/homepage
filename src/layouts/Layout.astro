---
import "../styles/global.css";
import MenuBar from "../components/MenuBar.astro";
import ExternalLink from "../components/ExternalLink.astro";
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <meta name="generator" content={Astro.generator} />
    <title>mi-nato</title>
  </head>
  <body class="bg-white text-gray-900">
    <MenuBar />
    <!-- 大画面時はサイドバーの分pr-sidebarをつける -->
    <main class="md:pr-sidebar min-h-screen md:pt-0">
      <slot />
    </main>
  </body>
  <footer
    id="footer"
    class="flex flex-col justify-around bg-white p-10 sm:mt-10 lg:ml-10 lg:p-15"
  >
    <div class="ml-2 flex flex-col">
      <ExternalLink href="https://github.com/NoCream-jp" text="GitHub" />
      <ExternalLink href="https://x.com/sXMN1au45a68174" text="X(Twitter)" />
      <ExternalLink
        href="https://atcoder.jp/users/Caffeineholic"
        text="AtCoder"
      />
      <ExternalLink href="https://www.instagram.com/?hl=ja" text="Instagram" />
    </div>
    ©2026 mi-nato.com
  </footer>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
