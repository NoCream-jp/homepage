---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lockScroll?: boolean;
}

const {
  title = "Minato Hayashi",
  description = "my portfolio / blog",
  lockScroll = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>

  <body
    class:list={[
      "flex min-h-screen flex-col overflow-x-hidden",
      lockScroll ? "lg:h-screen lg:min-h-0 lg:overflow-hidden" : "",
    ]}
  >
    <main
      class:list={[
        "flex min-h-0 flex-1 flex-col",
        lockScroll ? "lg:overflow-hidden" : "overflow-visible",
      ]}
    >
      <slot />
    </main>

    <footer class="flex h-13 shrink-0 items-center justify-center border-t">
      <p class="text-xs text-zinc-500">
        © Copyright 2025-{new Date().getFullYear()} Minato Hayashi
      </p>
    </footer>
  </body>
</html>
