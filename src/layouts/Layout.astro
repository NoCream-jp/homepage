---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import MenuBar from "../components/MenuBar.astro";
import ExternalLink from "../components/ExternalLink.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = "Minatoのポートフォリオ兼ブログです。",
  image = "/images/ogp-default.png", // public/images/ogp-default.png を用意してください
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/M.svg" />

    <!-- google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@100;200;300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
    <title>mi-nato</title>
    <ClientRouter />
  </head>
  <body class="bg-white text-gray-900">
    <MenuBar />
    <!-- 大画面時はサイドバーの分pr-sidebarをつける -->
    <main class="md:pr-sidebar min-h-screen md:pt-0">
      <slot />
    </main>
  </body><footer
    id="footer"
    class="flex flex-col justify-around bg-white p-5 sm:mt-10 md:p-10 lg:ml-8 lg:p-10"
  >
    <div class="ml-2 flex flex-col gap-3">
      <ExternalLink href="https://github.com/NoCream-jp" text="GitHub" />
      <ExternalLink href="https://x.com/sXMN1au45a68174" text="X(Twitter)" />
      <ExternalLink
        href="https://www.linkedin.com/in/m-hayashi/"
        text="LinkedIn"
      />
      <ExternalLink
        href="https://atcoder.jp/users/Caffeineholic"
        text="AtCoder"
      />
      ©2026 mi-nato.com
    </div>
  </footer>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  /*
   * Topページ遷移時専用のアニメーション
   * Astroのデフォルトのフェードや移動を完全に無効化する
   */
  html.transition-to-top {
    scroll-behavior: auto !important;
  }

  html.transition-to-top::view-transition-group(root),
  html.transition-to-top::view-transition-image-pair(root),
  html.transition-to-top::view-transition-old(root),
  html.transition-to-top::view-transition-new(root),
  html.transition-from-top::view-transition-group(root),
  html.transition-from-top::view-transition-image-pair(root),
  html.transition-from-top::view-transition-old(root),
  html.transition-from-top::view-transition-new(root) {
    animation: none !important;
    mix-blend-mode: normal !important;
  }

  /* 現在のページ（元の画面）はその場に完全に静止して残る */
  html.transition-to-top::view-transition-old(root) {
    z-index: 1;
    /* フェードアウトしないよう不透明度を固定 */
    opacity: 1 !important;
  }

  /* トップページ（新しい画面）が下から100%覆いかぶさるようにせり上がってくる */
  html.transition-to-top::view-transition-new(root) {
    animation: slide-up-panel 1s cubic-bezier(0.16, 1, 0.3, 1) both !important;
    z-index: 100;
    opacity: 1 !important;
  }

  @keyframes slide-up-panel {
    0% {
      transform: translateY(100%);
    }
    100% {
      transform: translateY(0);
    }
  }

  /*
   * トップ（/ ・ /#）から専用ページへ遷移するとき
   * トップを静止させ、新ページを右から横スライドで表示
   */
  html.transition-from-top::view-transition-old(root) {
    z-index: 1;
    opacity: 1 !important;
  }

  html.transition-from-top::view-transition-new(root) {
    animation: slide-in-panel-horizontal 1s cubic-bezier(0.16, 1, 0.3, 1) both !important;
    z-index: 100;
    opacity: 1 !important;
  }

  @keyframes slide-in-panel-horizontal {
    0% {
      transform: translateX(100%);
    }
    100% {
      transform: translateX(0);
    }
  }
</style>

<script>
  function getPathname(url: URL | string) {
    return typeof url === "string" ? new URL(url).pathname : url.pathname;
  }

  function isTopPage(pathname: string) {
    return pathname === "/";
  }

  function isCrossPageToTopHash(to: URL, from: URL | string) {
    return (
      to.pathname === "/" && to.hash !== "" && !isTopPage(getPathname(from))
    );
  }

  /** / または /# から /blog など専用ページへ */
  function isFromTopToDedicatedPage(to: URL, from: URL | string) {
    return isTopPage(getPathname(from)) && to.pathname !== "/";
  }

  /** クロスページ遷移中だけ instant。トップ内ハッシュは html.scroll-smooth に任せる */
  function scrollDocumentToHashInstant(doc: Document, hash: string) {
    if (!hash) return;
    const html = doc.documentElement;
    const prev = html.style.scrollBehavior;
    html.style.scrollBehavior = "auto";
    doc
      .querySelector(hash)
      ?.scrollIntoView({ behavior: "instant", block: "start" });
    html.style.scrollBehavior = prev;
  }

  function syncHistoryScrollPosition() {
    if (!history.state) return;
    history.replaceState({ ...history.state, scrollX, scrollY }, "");
  }

  let pendingCrossTopHash = "";
  let lockedHash = "";
  let restoreScrollTo: (() => void) | null = null;
  let removeScrollGuard: (() => void) | null = null;

  function disableTopHashScrollLock() {
    restoreScrollTo?.();
    lockedHash = "";
  }

  function disableScrollGuard() {
    removeScrollGuard?.();
    removeScrollGuard = null;
  }

  /** moveToLocation の scrollTo(0) とスクロール復元のズレを抑止 */
  function enableTopHashScrollLock(hash: string) {
    disableTopHashScrollLock();
    lockedHash = hash;
    const nativeScrollTo = window.scrollTo.bind(window);

    window.scrollTo = ((optionsOrX?: ScrollToOptions | number, y?: number) => {
      if (lockedHash && pendingCrossTopHash) {
        scrollDocumentToHashInstant(document, lockedHash);
        return;
      }
      if (typeof optionsOrX === "object") {
        nativeScrollTo(optionsOrX);
        return;
      }
      nativeScrollTo(optionsOrX ?? 0, y ?? 0);
    }) as typeof window.scrollTo;

    restoreScrollTo = () => {
      window.scrollTo = nativeScrollTo;
      restoreScrollTo = null;
    };
  }

  function enableScrollGuard(hash: string) {
    disableScrollGuard();
    const onScroll = () => {
      if (!pendingCrossTopHash) return;
      scrollDocumentToHashInstant(document, hash);
      syncHistoryScrollPosition();
    };
    window.addEventListener("scroll", onScroll, { capture: true });
    removeScrollGuard = () =>
      window.removeEventListener("scroll", onScroll, { capture: true });
  }

  function stabilizeCrossPageTopScroll(hash: string) {
    if (!hash || pendingCrossTopHash !== hash) return;

    pendingCrossTopHash = "";
    history.scrollRestoration = "manual";
    scrollDocumentToHashInstant(document, hash);
    syncHistoryScrollPosition();
    document.documentElement.classList.remove("transition-to-top");
    disableTopHashScrollLock();
    disableScrollGuard();
  }

  function armCrossPageTopTransition(
    hash: string,
    viewTransition?: ViewTransition
  ) {
    pendingCrossTopHash = hash;
    document.documentElement.classList.add("transition-to-top");
    history.scrollRestoration = "manual";
    enableTopHashScrollLock(hash);
    enableScrollGuard(hash);

    if (viewTransition) {
      viewTransition.finished.then(() => stabilizeCrossPageTopScroll(hash));
    }
  }

  function cancelCrossPageTopTransition() {
    pendingCrossTopHash = "";
    document.documentElement.classList.remove("transition-to-top");
    disableTopHashScrollLock();
    disableScrollGuard();
  }

  let pendingFromTop = false;

  function stabilizeFromTopTransition() {
    pendingFromTop = false;
    document.documentElement.classList.remove("transition-from-top");
  }

  function armFromTopTransition(viewTransition?: ViewTransition) {
    pendingFromTop = true;
    document.documentElement.classList.add("transition-from-top");
    viewTransition?.finished.then(() => stabilizeFromTopTransition());
  }

  function cancelFromTopTransition() {
    pendingFromTop = false;
    document.documentElement.classList.remove("transition-from-top");
  }

  document.addEventListener("astro:before-preparation", (ev) => {
    cancelCrossPageTopTransition();
    cancelFromTopTransition();

    if (isCrossPageToTopHash(ev.to, ev.from)) {
      armCrossPageTopTransition(ev.to.hash);
    } else if (isFromTopToDedicatedPage(ev.to, ev.from)) {
      armFromTopTransition();
    }
  });

  document.addEventListener("astro:before-swap", (ev) => {
    if (isCrossPageToTopHash(ev.to, ev.from)) {
      const html = ev.newDocument.documentElement;
      html.classList.add("transition-to-top");
      scrollDocumentToHashInstant(ev.newDocument, ev.to.hash);

      ev.viewTransition?.finished.then(() =>
        stabilizeCrossPageTopScroll(ev.to.hash)
      );
      return;
    }

    if (!isFromTopToDedicatedPage(ev.to, ev.from)) return;

    ev.newDocument.documentElement.classList.add("transition-from-top");
    ev.viewTransition?.finished.then(() => stabilizeFromTopTransition());
  });

  // moveToLocation（scrollRestoration=auto → location.href）の直後に復元を上書き
  document.addEventListener("astro:after-swap", () => {
    if (!pendingCrossTopHash) return;
    history.scrollRestoration = "manual";
    scrollDocumentToHashInstant(document, pendingCrossTopHash);
    syncHistoryScrollPosition();
  });

  // updateCallbackDone はアニメより先に走るため、ここでは触らない
  document.addEventListener("astro:page-load", () => {
    if (!document.startViewTransition) {
      if (pendingCrossTopHash) {
        stabilizeCrossPageTopScroll(pendingCrossTopHash);
      }
      if (pendingFromTop) {
        stabilizeFromTopTransition();
      }
    }
  });
</script>
