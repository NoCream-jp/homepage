---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="relative inline-flex overflow-hidden">
  <!-- 1つ目のテキスト（通常時） -->
  <span class="transition-transform duration-300 group-hover:-translate-y-full">
    {text}
  </span>

  <!-- 2つ目のテキスト（ホバー時） -->
  <span
    class="text-primary absolute top-0 left-0 translate-y-full transition-transform duration-300 group-hover:translate-y-0"
    aria-hidden="true"
  >
    {text}
  </span>
</span>
