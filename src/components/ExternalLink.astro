---
interface Props {
  href: string;
  text: string;
  description?: string;
  showFavicon?: boolean;
  image?: string;
}

const {
  href,
  text,
  description = null,
  showFavicon = true,
  image: imageOverride,
} = Astro.props;

// ドメイン抽出
let domain = "";
try {
  domain = new URL(href).hostname;
} catch {}

// favicon URL生成
const faviconUrl = domain
  ? `https://www.google.com/s2/favicons?domain=${domain}&sz=64`
  : null;

const getOgImage = async (url: string) => {
  try {
    const response = await fetch(url, {
      headers: { "user-agent": "Mozilla/5.0 (compatible; mi-nato.com)" },
      signal: AbortSignal.timeout(5000),
    });

    if (!response.ok) return null;

    const html = await response.text();
    const metaTags = html.match(/<meta\b[^>]*>/gi) ?? [];

    for (const tag of metaTags) {
      const property = tag.match(/\bproperty\s*=\s*["']([^"']+)["']/i)?.[1];
      const name = tag.match(/\bname\s*=\s*["']([^"']+)["']/i)?.[1];
      const content = tag.match(/\bcontent\s*=\s*["']([^"']*)["']/i)?.[1];

      if ((property === "og:image" || name === "twitter:image") && content) {
        return new URL(content, url).href;
      }
    }
  } catch {
    // External pages may reject build-time requests or omit OGP metadata.
  }

  return null;
};

const ogImage = imageOverride ?? (await getOgImage(href));
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group mb-2 flex items-center gap-3 rounded-md border border-(--site-border) px-4 py-4 transition-colors hover:border-(--site-border-strong)"
>
  <!-- アイコン部分 -->
  <span
    class="bg-canvas flex aspect-5/3 w-24 flex-none items-center justify-center overflow-hidden"
  >
    <!-- {
      showFavicon && faviconUrl ? (
        <img
          src={faviconUrl}
          alt=""
          class="h-5 w-5 rounded-sm"
          loading="lazy"
        />
      ) : (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="9" />

          <path d="M12 3a15 15 0 0 1 0 18" />
          <path d="M12 3a15 15 0 0 0 0 18" />

          <path d="M3 12h18" />
          <path d="M5 8c2.5 1 11.5 1 14 0" />
          <path d="M5 16c2.5-1 11.5-1 14 0" />
        </svg>
      )
    } -->
    {
      ogImage ? (
        <img
          src={ogImage}
          alt=""
          class="h-full object-contain"
          loading="lazy"
        />
      ) : (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="9" />

          <path d="M12 3a15 15 0 0 1 0 18" />
          <path d="M12 3a15 15 0 0 0 0 18" />

          <path d="M3 12h18" />
          <path d="M5 8c2.5 1 11.5 1 14 0" />
          <path d="M5 16c2.5-1 11.5-1 14 0" />
        </svg>
      )
    }
  </span>

  <!-- テキスト -->
  <div class="min-w-0 flex-1">
    <div class="truncate font-medium group-hover:text-zinc-600">{text}</div>
    {
      description && (
        <div class="truncate text-sm text-zinc-400">{description}</div>
      )
    }
  </div>

  <!-- 矢印 -->
  <span
    class="text-primary flex h-8 w-8 flex-none items-center justify-center transition-colors group-hover:text-zinc-600"
    aria-label="外部リンク"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M7 17 17 7"></path>
      <path d="M9 7h8v8"></path>
    </svg>
  </span>
</a>
