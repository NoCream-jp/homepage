---
// src/components/ExternalLink.astro

interface Props {
  href: string;
  text: string;
  description?: string;
  showFavicon?: boolean; // 追加
}

const { href, text, description = null, showFavicon = true } = Astro.props;

// ドメイン抽出
let domain = "";
try {
  domain = new URL(href).hostname;
} catch {}

// favicon URL生成
const faviconUrl = domain
  ? `https://www.google.com/s2/favicons?domain=${domain}&sz=64`
  : null;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group mb-2 flex items-center gap-3 rounded-lg border px-4 py-4 transition-colors hover:border-zinc-600"
>
  <!-- アイコン部分 -->
  <span class="flex-none">
    <!-- {
      showFavicon && faviconUrl ? (
        <img
          src={faviconUrl}
          alt=""
          class="h-5 w-5 rounded-sm"
          loading="lazy"
        />
      ) : (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="9" />

          <path d="M12 3a15 15 0 0 1 0 18" />
          <path d="M12 3a15 15 0 0 0 0 18" />

          <path d="M3 12h18" />
          <path d="M5 8c2.5 1 11.5 1 14 0" />
          <path d="M5 16c2.5-1 11.5-1 14 0" />
        </svg>
      )
    } -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="9"></circle>

      <path d="M12 3a15 15 0 0 1 0 18"></path>
      <path d="M12 3a15 15 0 0 0 0 18"></path>

      <path d="M3 12h18"></path>
      <path d="M5 8c2.5 1 11.5 1 14 0"></path>
      <path d="M5 16c2.5-1 11.5-1 14 0"></path>
    </svg>
  </span>

  <!-- テキスト -->
  <div class="min-w-0 flex-1">
    <div class="truncate font-medium group-hover:text-zinc-600">{text}</div>
    {
      description && (
        <div class="truncate text-sm text-zinc-400">{description}</div>
      )
    }
  </div>

  <!-- 矢印 -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="rotate-315 text-black group-hover:text-zinc-600"
  >
    <path d="M5 12h14"></path>
    <path d="m12 5 7 7-7 7"></path>
  </svg>
</a>
