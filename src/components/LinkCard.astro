---
interface Props {
  title: string;
  username?: string;
  href?: string;
  bg?: string;
  disabled?: boolean;
}

const {
  title,
  username,
  href = "#",
  bg = "bg-white",
  disabled = false,
} = Astro.props;

const Tag = disabled ? "div" : "a";
---

<Tag
  {...!disabled && {
    href,
    target: "_blank",
    rel: "noopener noreferrer",
  }}
  class={`group max-h-15 h-full w-auto self-stretch rounded-md border p-1  ${bg} ${disabled ? "cursor-default " : "hover:border-zinc-500"}`}
>
  <div class="flex h-full items-center justify-between">
    <!-- 左側 -->
    <div class="flex flex-col">
      <span
        class={`text-sm font-medium text-zinc-800  ${disabled ? "" : "group-hover:text-zinc-400"}`}
      >
        {title}
      </span>

      {
        username && (
          <span class="mt-0 text-[10px] text-zinc-400">{username}</span>
        )
      }
    </div>

    <!-- 右側アイコン -->
    <div
      class={`flex justify-center text-zinc-700 transition ${disabled ? "opacity-0" : "group-hover:text-zinc-400"}`}
    >
      <svg
        class="h-5 w-auto"
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        ><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE -->
        <path fill="currentColor" d="M6.4 18L5 16.6L14.6 7H6V5h12v12h-2V8.4z"
        ></path></svg
      >
    </div>
  </div>
</Tag>
