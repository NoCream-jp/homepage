---
interface Props {
  title: string;
  username?: string;
  href?: string;
  bg?: string;
  disabled?: boolean;
}

const {
  title,
  username,
  href = "#",
  bg = "bg-white",
  disabled = false,
} = Astro.props;

const Tag = disabled ? "div" : "a";
---

<Tag
  {...!disabled && {
    href,
    target: "_blank",
    rel: "noopener noreferrer",
  }}
  class:list={[
    "group h-full max-h-15 w-auto self-stretch rounded-md border px-3 py-2",
    disabled ? "cursor-default bg-zinc-100" : `${bg} hover:border-zinc-600`,
  ]}
>
  <div
    class:list={[
      "flex h-full items-center",
      disabled ? "justify-center" : "justify-between",
    ]}
  >
    <!-- 左側 -->
    <div class:list={[disabled ? "text-center" : "flex flex-col"]}>
      <span
        class:list={[
          "text-sm font-medium",
          !disabled && "group-hover:text-zinc-600",
        ]}
      >
        {title}
      </span>

      {
        username && (
          <span class="mt-0 text-[10px] text-zinc-400">{username}</span>
        )
      }
    </div>

    <!-- 右側アイコン -->
    {
      !disabled && (
        <div class="flex justify-center text-zinc-700 transition group-hover:text-zinc-600">
          <svg
            class="h-5 w-5"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7 17L17 7M17 7H9M17 7v8"
            />
          </svg>
        </div>
      )
    }
  </div>
</Tag>
