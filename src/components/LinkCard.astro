---
interface Props {
  title: string;
  username?: string;
  href?: string;
  bg?: string;
  disabled?: boolean;
}

const {
  title,
  username,
  href = "#",
  bg = "bg-white",
  disabled = false,
} = Astro.props;

const Tag = disabled ? "div" : "a";
---

<Tag
  {...!disabled && {
    href,
    target: "_blank",
    rel: "noopener noreferrer",
  }}
  class={`group max-h-15 h-full w-auto self-stretch rounded-md border px-3  ${bg} ${disabled ? "cursor-default " : "hover:border-zinc-500"}`}
>
  <div class="flex h-full items-center justify-between">
    <!-- 左側 -->
    <div class="flex flex-col">
      <span
        class={`text-sm font-medium text-zinc-800  ${disabled ? "" : "group-hover:text-zinc-400"}`}
      >
        {title}
      </span>

      {
        username && (
          <span class="mt-0 text-[10px] text-zinc-400">{username}</span>
        )
      }
    </div>

    <!-- 右側アイコン -->
    <div
      class={`flex justify-center text-zinc-700 transition ${disabled ? "hidden" : "group-hover:text-zinc-400"}`}
    >
      <svg
        class="h-5 w-5"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M7 17L17 7M17 7H9M17 7v8"></path>
      </svg>
    </div>
  </div>
</Tag>
