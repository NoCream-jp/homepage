---
import type { CollectionEntry } from "astro:content";

interface Props {
  item: CollectionEntry<"learning">;
}
const { item } = Astro.props;

// 表示文字列
const title = item.data.title ?? item.id;

const logoSrc = item.data.logo;

// ロゴが無いときのイニシャル
function initialsOf(s: string) {
  if (!s) return "";
  const parts = s.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[1][0]).slice(0, 2).toUpperCase();
}
const initials = initialsOf(String(title));
---

<article
  class="cert-card group relative flex w-full items-center gap-4 overflow-hidden rounded-md border bg-white px-4 py-3 transition-colors duration-150 ease-out focus-within:outline-none"
  role="article"
  aria-labelledby={`learning-title-${item.id}`}
  data-tags={item.data.tags?.join(",") ?? ""}
>
  <div class="shrink-0">
    {
      logoSrc ? (
        <>
          <img
            src={logoSrc}
            alt={`${title} logo`}
            class="h-10 w-10 rounded-md object-contain"
            loading="lazy"
            onerror="this.style.display='none'; const fb = this.nextElementSibling; if(fb) fb.style.display='flex';"
          />
          <div
            style="display:none"
            class="flex h-10 w-10 items-center justify-center rounded-md border border-black/5 bg-black/5 text-sm font-medium text-zinc-900"
            aria-hidden="true"
          >
            {initials}
          </div>
        </>
      ) : (
        <div
          class="flex h-10 w-10 items-center justify-center rounded-md border border-black/5 bg-black/5 text-sm font-medium text-zinc-900"
          aria-hidden="true"
        >
          {initials}
        </div>
      )
    }
  </div>

  <!-- タイトル -->
  <div class="min-w-0">
    <h3
      id={`learning-title-${item.id}`}
      class="truncate text-sm font-medium text-zinc-900"
      title={String(title)}
    >
      {title}
    </h3>
  </div>

  <style>
    :global(.cert-card:focus-within),
    :global(.cert-card:focus-visible) {
      box-shadow: 0 0 0 3px rgb(0 0 0 / 6%);
      border-color: rgb(0 0 0 / 40%);
    }
  </style>
</article>
