---
interface Props {
  href: string;
  text?: string;
}

const { href, text } = Astro.props;
const showText = text?.trim() ? text : "View More";
---

<a
  href={href}
  class="align-center flex w-20 justify-center rounded-full border p-1 text-center text-xs hover:border-zinc-500 hover:text-zinc-500"
>
  {showText}
</a>
