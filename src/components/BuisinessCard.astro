---
interface Props {
  name: string;
  age: string | number;
  location: string;
  pronoun: string;
  study: string;
  image?: string;
}

const {
  name,
  age,
  location,
  pronoun,
  study,
  image = "/images/brand/logo.png",
} = Astro.props;
---

<div
  id="profile-card"
  class="relative aspect-8/5 w-full max-w-100 cursor-pointer"
>
  <div
    id="profile-card-inner"
    class="relative h-full w-full"
    style="transform-style: preserve-3d;"
  >
    <!-- 表 -->
    <div
      class="absolute inset-0 rounded-xl border bg-white p-4 md:p-6"
      style="backface-visibility: hidden;"
    >
      <!-- 左上：画像 -->
      <div class="absolute top-6 left-6">
        <div class="h-32 w-32 overflow-hidden rounded-full border bg-white">
          {
            image && (
              <img src={image} alt="" class="h-full w-full object-cover" />
            )
          }
        </div>
      </div>

      <!-- 右上：装飾 -->
      <div
        class="absolute top-4 right-4 h-8 w-8 rounded-full bg-zinc-100 md:top-6 md:right-6 md:h-10 md:w-10"
      >
      </div>

      <!-- 右下寄せ：テキスト -->
      <div class="absolute right-4 bottom-4 flex flex-col gap-1 text-sm">
        <div class="flex gap-2 whitespace-nowrap">
          <span class="w-20 text-right text-zinc-500 md:w-24"> name : </span>
          <span class="font-semibold">{name}</span>
        </div>

        <div class="flex gap-2 whitespace-nowrap">
          <span class="w-20 text-right text-zinc-500 md:w-24"> age : </span>
          <span>{age}</span>
        </div>

        <div class="flex gap-2 whitespace-nowrap">
          <span class="w-20 text-right text-zinc-500 md:w-24">
            location :
          </span>
          <span>{location}</span>
        </div>

        <div class="flex gap-2 whitespace-nowrap">
          <span class="w-20 text-right text-zinc-500 md:w-24"> pronoun : </span>
          <span>{pronoun}</span>
        </div>

        <div class="flex gap-2 whitespace-nowrap">
          <span class="w-20 text-right text-zinc-500 md:w-24"> study : </span>
          <span>{study}</span>
        </div>
      </div>
    </div>

    <!-- 裏 -->
    <div
      class="absolute inset-0 flex flex-row items-center justify-between gap-4 rounded-xl border bg-white p-4 sm:gap-6 sm:p-6 md:p-8"
      style="backface-visibility: hidden; transform: rotateY(180deg);"
    >
      <!-- 左 -->
      <div class="flex flex-1 flex-col justify-center gap-2 sm:gap-3">
        <h3 class="text-base font-bold text-zinc-800 md:text-lg">About Me</h3>
        <p class="text-[10px] leading-4 text-zinc-600 sm:text-xs md:text-sm">
          大学で強化学習について研究しています。<br class="hidden sm:block" />
          コーヒーが好きです。猫が好きです。息抜きの達人です。
        </p>
        <p class="mt-1 text-[10px] font-medium text-zinc-500 sm:text-xs">
          Thanks for visiting my portfolio!
        </p>
      </div>

      <!-- 右 -->
      <div class="flex shrink-0 flex-col items-center gap-1 sm:gap-2">
        <div
          class="h-20 w-20 overflow-hidden rounded-md border bg-white p-1.5 sm:h-24 sm:w-24 md:h-28 md:w-28"
        >
          <img
            src="/images/brand/qrcode.png"
            alt="QR Code"
            class="h-full w-full object-contain"
          />
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const PROFILE_CARD_STORAGE_KEY = "profile-card-flipped";

  const setupProfileCard = () => {
    const card = document.querySelector<HTMLElement>(/**/ "#profile-card");
    const inner = document.querySelector<HTMLElement>(
      /**/ "#profile-card-inner"
    );

    if (!card || !inner) return;
    if (card.dataset.initialized === "true") return;
    card.dataset.initialized = "true";

    // saved state
    const savedState = sessionStorage.getItem(PROFILE_CARD_STORAGE_KEY);
    let flipped = savedState === "true";

    // initial transform for inner (front/back)
    inner.style.transform = flipped
      ? "perspective(1200px) rotateY(180deg)"
      : "perspective(1200px) rotateY(0deg)";
    inner.dataset.flipped = String(flipped);

    // reduced motion?
    const prefersReduced =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // state for smooth interpolation
    let currentX = 0,
      currentY = 0,
      currentZ = 0,
      currentScale = 1;
    let targetX = 0,
      targetY = 0,
      targetZ = 0,
      targetScale = 1;
    let rafId = 0;

    // coefficients (調整可)
    const yawFactor = 3.5; // 横（rotateY）強さ、正値（visualX の符号で方向決定）
    const pitchFactor = -3.5; // 縦（rotateX）強さ
    const twistFactor = 1.2; // 斜め（rotateZ）
    const easing = 0.12;

    const updateTilt = () => {
      // if reduced motion requested, smoothly return to neutral without tilt
      if (prefersReduced) {
        currentX += (0 - currentX) * easing;
        currentY += (0 - currentY) * easing;
        currentZ += (0 - currentZ) * easing;
        currentScale += (1 - currentScale) * easing;
      } else {
        currentX += (targetX - currentX) * easing;
        currentY += (targetY - currentY) * easing;
        currentZ += (targetZ - currentZ) * easing;
        currentScale += (targetScale - currentScale) * easing;
      }

      card.style.transform = `
        perspective(1000px)
        rotateX(${currentX}deg)
        rotateY(${currentY}deg)
        rotateZ(${currentZ}deg)
        scale(${currentScale})
      `;

      rafId = requestAnimationFrame(updateTilt);
    };

    const handleMouseMove = (
      event: Pick<MouseEvent, "clientX" | "clientY">
    ) => {
      const rect = card.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width;
      const y = (event.clientY - rect.top) / rect.height;

      // normalized: -1 .. 1
      const normalizedX = Math.max(-1, Math.min(1, x * 2 - 1));
      const normalizedY = Math.max(-1, Math.min(1, y * 2 - 1));

      // 重要：visualX は常に normalizedX（裏でも反転しない）
      const visualX = normalizedX;

      // 計算（yawFactor は正。visualX の符号で向きを決定）
      targetY = visualX * yawFactor;
      targetX = normalizedY * pitchFactor;
      targetZ = visualX * normalizedY * twistFactor;

      // 端へ行くほど軽くスケールアップ
      const distance = Math.min(
        1,
        Math.sqrt(normalizedX * normalizedX + normalizedY * normalizedY)
      );
      targetScale = 1 + distance * 0.012;
    };

    const handleMouseLeave = () => {
      targetX = 0;
      targetY = 0;
      targetZ = 0;
      targetScale = 1;
    };

    // touch support: map touchmove to mousemove semantics
    const handleTouchMove = (ev: TouchEvent) => {
      if (!ev.touches || ev.touches.length === 0) return;
      const t = ev.touches[0];

      handleMouseMove({
        clientX: t.clientX,
        clientY: t.clientY,
      });
    };

    // add listeners
    card.addEventListener("mousemove", handleMouseMove);
    card.addEventListener("mouseleave", handleMouseLeave);
    card.addEventListener("touchmove", handleTouchMove, { passive: true });
    card.addEventListener("touchend", handleMouseLeave);

    // start RAF
    rafId = requestAnimationFrame(updateTilt);

    // click (flip) — update flipped state before animating so mouse handlers see correct state
    card.addEventListener("click", () => {
      // toggle flipped state first (so dataset reflects new state immediately)
      flipped = !flipped;
      inner.dataset.flipped = String(flipped);
      sessionStorage.setItem(PROFILE_CARD_STORAGE_KEY, String(flipped));

      // cancel in-progress animations on inner
      inner.getAnimations().forEach((animation) => animation.cancel());

      const target = flipped ? 180 : 0;
      const start = flipped ? 0 : 180; // note: we swapped start/target so animation goes the right direction

      inner.animate(
        [
          {
            transform: `
              perspective(1200px)
              rotateY(${start}deg)
              rotateX(0deg)
              rotateZ(0deg)
              translateY(0)
              scale(1)
            `,
          },
          {
            transform: `
              perspective(1200px)
              rotateY(${start + (target - start) * 0.4}deg)
              rotateX(2deg)
              rotateZ(${flipped ? "-0.5deg" : "0.5deg"})
              translateY(-3px)
              scale(1.02)
            `,
          },
          {
            transform: `
              perspective(1200px)
              rotateY(${start + (target - start) * 0.58}deg)
              rotateX(-1deg)
              rotateZ(${flipped ? "0.25deg" : "-0.25deg"})
              translateY(-2px)
              scale(1.015)
            `,
          },
          {
            transform: `
              perspective(1200px)
              rotateY(${target}deg)
              rotateX(0deg)
              rotateZ(0deg)
              translateY(0)
              scale(1)
            `,
          },
        ],
        {
          duration: 700,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          fill: "forwards",
        }
      );
    });

    // cleanup on page unload / astro navigation
    const cleanup = () => {
      card.removeEventListener("mousemove", handleMouseMove);
      card.removeEventListener("mouseleave", handleMouseLeave);
      card.removeEventListener("touchmove", handleTouchMove);
      card.removeEventListener("touchend", handleMouseLeave);
      cancelAnimationFrame(rafId);
    };

    window.addEventListener("beforeunload", cleanup);
    document.addEventListener("astro:page-unload", cleanup);
    document.addEventListener("astro:page-load", () => {
      // re-init only if needed (this component guards with dataset.initialized)
    });
  };

  setupProfileCard();
  document.addEventListener("astro:page-load", setupProfileCard);
</script>
