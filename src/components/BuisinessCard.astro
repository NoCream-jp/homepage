---
interface Props {
  name: string;
  age: string | number;
  location: string;
  pronoun: string;
  study: string;
  image?: string;
}

const {
  name,
  age,
  location,
  pronoun,
  study,
  image = "/images/brand/logo.png",
} = Astro.props;
---

<div
  id="profile-card"
  class="relative z-10 aspect-8/5 w-full max-w-100 cursor-pointer touch-manipulation @container"
>
  <div
    id="profile-card-inner"
    class="relative h-full w-full"
    style="transform-style: preserve-3d;"
  >
    <!-- 表 -->
    <div
      class="absolute inset-0 rounded-[3cqw] border-[0.25cqw] bg-white p-[6cqw]"
      style="backface-visibility: hidden;"
    >
      <!-- 左上：画像 -->
      <div class="absolute top-[6cqw] left-[6cqw]">
        <div
          class="h-[32cqw] w-[32cqw] overflow-hidden rounded-full border-[0.25cqw] bg-white"
        >
          {
            image && (
              <img
                src={image}
                alt=""
                class="h-full w-full object-cover"
                draggable="false"
              />
            )
          }
        </div>
      </div>

      <!-- 右上：装飾 -->
      <div
        class="absolute top-[4cqw] right-[4cqw] h-[10cqw] w-[10cqw] rounded-full bg-zinc-100"
      >
      </div>

      <!-- 右下寄せ：テキスト -->
      <div
        class="absolute right-[4cqw] bottom-[4cqw] flex flex-col gap-[2cqw] text-[3.5cqw]"
      >
        <div class="flex gap-[2cqw] whitespace-nowrap">
          <span class="w-[20cqw] text-right text-zinc-500">
            name :
          </span>
          <span class="font-semibold">{name}</span>
        </div>

        <div class="flex gap-[2cqw] whitespace-nowrap">
          <span class="w-[20cqw] text-right text-zinc-500">
            age :
          </span>
          <span>{age}</span>
        </div>

        <div class="flex gap-[2cqw] whitespace-nowrap">
          <span class="w-[20cqw] text-right text-zinc-500">
            location :
          </span>
          <span>{location}</span>
        </div>

        <div class="flex gap-[2cqw] whitespace-nowrap">
          <span class="w-[20cqw] text-right text-zinc-500">
            pronoun :
          </span>
          <span>{pronoun}</span>
        </div>

        <div class="flex gap-[2cqw] whitespace-nowrap">
          <span class="w-[20cqw] text-right text-zinc-500">
            study :
          </span>
          <span>{study}</span>
        </div>
      </div>
    </div>

    <!-- 裏 -->
    <div
      class="absolute inset-0 flex flex-row items-center justify-between gap-[6cqw] rounded-[3cqw] border-[0.25cqw] bg-white p-[8cqw]"
      style="backface-visibility: hidden; transform: rotateY(180deg);"
    >
      <!-- 左 -->
      <div class="flex flex-1 flex-col justify-center gap-[3cqw]">
        <h3 class="text-[4.5cqw] font-bold text-zinc-800">
          About Me
        </h3>

        <p
          class="text-[3.5cqw] leading-[5cqw] text-zinc-600"
        >
          大学で強化学習について研究しています。<br />
          コーヒーが好きです。猫が好きです。息抜きの達人です。
        </p>

        <p
          class="mt-[1cqw] text-[3cqw] leading-[4cqw] font-medium text-zinc-500"
        >
          Thanks for visiting my portfolio!
        </p>
      </div>

      <!-- 右 -->
      <div class="flex shrink-0 flex-col items-center gap-[2cqw]">
        <div
          class="h-[28cqw] w-[28cqw] overflow-hidden rounded-[1.5cqw] border-[0.25cqw] bg-white p-[1.5cqw]"
        >
          <img
            src="/images/brand/qrcode.png"
            alt="QR Code"
            class="h-full w-full object-contain"
            draggable="false"
          />
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const PROFILE_CARD_STORAGE_KEY = "profile-card-flipped";

  const setupProfileCard = () => {
    const card = document.querySelector<HTMLElement>("#profile-card");
    const inner = document.querySelector<HTMLElement>(
      "#profile-card-inner"
    );

    if (!card || !inner) return;
    if (card.dataset.initialized === "true") return;

    card.dataset.initialized = "true";

    // 保存済みの表裏状態
    const savedState = sessionStorage.getItem(
      PROFILE_CARD_STORAGE_KEY
    );

    let flipped = savedState === "true";

    // 初期状態
    inner.style.transform = flipped
      ? "perspective(300cqw) rotateY(180deg)"
      : "perspective(300cqw) rotateY(0deg)";

    inner.dataset.flipped = String(flipped);

    // reduced motion
    const prefersReduced =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // マウス追従用の状態
    let currentX = 0;
    let currentY = 0;
    let currentZ = 0;
    let currentScale = 1;

    let targetX = 0;
    let targetY = 0;
    let targetZ = 0;
    let targetScale = 1;

    let rafId = 0;

    const yawFactor = 3.5;
    const pitchFactor = -3.5;
    const twistFactor = 1.2;
    const easing = 0.12;

    const updateTilt = () => {
      if (prefersReduced) {
        currentX += (0 - currentX) * easing;
        currentY += (0 - currentY) * easing;
        currentZ += (0 - currentZ) * easing;
        currentScale += (1 - currentScale) * easing;
      } else {
        currentX += (targetX - currentX) * easing;
        currentY += (targetY - currentY) * easing;
        currentZ += (targetZ - currentZ) * easing;
        currentScale += (targetScale - currentScale) * easing;
      }

      card.style.transform = `
        perspective(250cqw)
        rotateX(${currentX}deg)
        rotateY(${currentY}deg)
        rotateZ(${currentZ}deg)
        scale(${currentScale})
      `;

      rafId = requestAnimationFrame(updateTilt);
    };

    const handlePointerMove = (
      event: Pick<PointerEvent, "clientX" | "clientY">
    ) => {
      const rect = card.getBoundingClientRect();

      if (rect.width === 0 || rect.height === 0) return;

      const x = (event.clientX - rect.left) / rect.width;
      const y = (event.clientY - rect.top) / rect.height;

      const normalizedX = Math.max(
        -1,
        Math.min(1, x * 2 - 1)
      );

      const normalizedY = Math.max(
        -1,
        Math.min(1, y * 2 - 1)
      );

      const visualX = normalizedX;

      targetY = visualX * yawFactor;
      targetX = normalizedY * pitchFactor;
      targetZ =
        visualX * normalizedY * twistFactor;

      const distance = Math.min(
        1,
        Math.sqrt(
          normalizedX * normalizedX +
            normalizedY * normalizedY
        )
      );

      targetScale = 1 + distance * 0.012;
    };

    const handlePointerLeave = () => {
      targetX = 0;
      targetY = 0;
      targetZ = 0;
      targetScale = 1;
    };

    const handlePointerUp = (event: PointerEvent) => {
      // マウスの右クリックなどでは反転しない
      if (event.pointerType === "mouse" && event.button !== 0) {
        return;
      }

      flipped = !flipped;

      inner.dataset.flipped = String(flipped);

      sessionStorage.setItem(
        PROFILE_CARD_STORAGE_KEY,
        String(flipped)
      );

      inner.getAnimations().forEach((animation) => {
        animation.cancel();
      });

      const target = flipped ? 180 : 0;
      const start = flipped ? 0 : 180;

      inner.animate(
        [
          {
            transform: `
              perspective(300cqw)
              rotateY(${start}deg)
              rotateX(0deg)
              rotateZ(0deg)
              translateY(0)
              scale(1)
            `,
          },
          {
            transform: `
              perspective(300cqw)
              rotateY(${start + (target - start) * 0.4}deg)
              rotateX(2deg)
              rotateZ(${flipped ? "-0.5deg" : "0.5deg"})
              translateY(-0.75cqw)
              scale(1.02)
            `,
          },
          {
            transform: `
              perspective(300cqw)
              rotateY(${start + (target - start) * 0.58}deg)
              rotateX(-1deg)
              rotateZ(${flipped ? "0.25deg" : "-0.25deg"})
              translateY(-0.5cqw)
              scale(1.015)
            `,
          },
          {
            transform: `
              perspective(300cqw)
              rotateY(${target}deg)
              rotateX(0deg)
              rotateZ(0deg)
              translateY(0)
              scale(1)
            `,
          },
        ],
        {
          duration: 700,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          fill: "forwards",
        }
      );
    };

    card.addEventListener(
      "pointermove",
      handlePointerMove
    );

    card.addEventListener(
      "pointerleave",
      handlePointerLeave
    );

    card.addEventListener(
      "pointerup",
      handlePointerUp
    );

    rafId = requestAnimationFrame(updateTilt);

    const cleanup = () => {
      card.removeEventListener(
        "pointermove",
        handlePointerMove
      );

      card.removeEventListener(
        "pointerleave",
        handlePointerLeave
      );

      card.removeEventListener(
        "pointerup",
        handlePointerUp
      );

      cancelAnimationFrame(rafId);
    };

    window.addEventListener(
      "beforeunload",
      cleanup
    );

    document.addEventListener(
      "astro:page-unload",
      cleanup
    );
  };

  setupProfileCard();

  document.addEventListener(
    "astro:page-load",
    setupProfileCard
  );
</script>

