---
interface Props {
  name: string;
  age: string | number;
  location: string;
  pronoun: string;
  study: string;
  image?: string;
}

const {
  name,
  age,
  location,
  pronoun,
  study,
  image = "/images/brand/logo.png",
} = Astro.props;
---

<div
  id="profile-card"
  class="@container relative z-10 aspect-8/5 w-full max-w-100 cursor-pointer touch-manipulation"
>
  <div
    id="profile-card-inner"
    class="relative h-full w-full"
    style="transform-style: preserve-3d;"
  >
    <!-- 表 -->
    <div
      class="absolute inset-0 rounded-[3cqw] border-[0.25cqw] bg-white p-[6cqw]"
      style="backface-visibility: hidden;"
    >
      <!-- 左上：画像 -->
      <div class="absolute top-[6cqw] left-[6cqw]">
        <div
          class="h-[32cqw] w-[32cqw] overflow-hidden rounded-full border-[0.25cqw] bg-white"
        >
          {
            image && (
              <img
                src={image}
                alt=""
                class="h-full w-full object-cover"
                draggable="false"
              />
            )
          }
        </div>
      </div>

      <!-- 右上：装飾 -->
      <div
        class="absolute top-[4cqw] right-[4cqw] h-[10cqw] w-[10cqw] rounded-full bg-zinc-100"
      >
      </div>

      <!-- 右下寄せ：テキスト -->
      <div
        class="absolute right-[4cqw] bottom-[4cqw] flex flex-col gap-[2cqw] text-[3.5cqw]"
      >
        <div class="flex gap-[2cqw] whitespace-nowrap">
          <span class="w-[20cqw] text-right text-zinc-500"> name : </span>
          <span class="font-semibold">{name}</span>
        </div>

        <div class="flex gap-[2cqw] whitespace-nowrap">
          <span class="w-[20cqw] text-right text-zinc-500"> age : </span>
          <span>{age}</span>
        </div>

        <div class="flex gap-[2cqw] whitespace-nowrap">
          <span class="w-[20cqw] text-right text-zinc-500"> location : </span>
          <span>{location}</span>
        </div>

        <div class="flex gap-[2cqw] whitespace-nowrap">
          <span class="w-[20cqw] text-right text-zinc-500"> pronoun : </span>
          <span>{pronoun}</span>
        </div>

        <div class="flex gap-[2cqw] whitespace-nowrap">
          <span class="w-[20cqw] text-right text-zinc-500"> study : </span>
          <span>{study}</span>
        </div>
      </div>
    </div>

    <!-- 裏 -->
    <div
      class="absolute inset-0 flex flex-row items-center justify-between gap-[6cqw] rounded-[3cqw] border-[0.25cqw] bg-white p-[8cqw]"
      style="backface-visibility: hidden; transform: rotateY(180deg);"
    >
      <!-- 左 -->
      <div class="flex flex-1 flex-col justify-center gap-[3cqw]">
        <h3 class="text-[4.5cqw] font-bold text-zinc-800">About Me</h3>

        <p class="text-[3.5cqw] leading-[5cqw] text-zinc-600">
          大学で強化学習について研究しています。<br />
          コーヒーが好きです。猫が好きです。息抜きの達人です。
        </p>

        <p
          class="mt-[1cqw] text-[3cqw] leading-[4cqw] font-medium text-zinc-500"
        >
          Thanks for visiting my portfolio!
        </p>
      </div>

      <!-- 右 -->
      <div class="flex shrink-0 flex-col items-center gap-[2cqw]">
        <div
          class="h-[28cqw] w-[28cqw] overflow-hidden rounded-[1.5cqw] border-[0.25cqw] bg-white p-[1.5cqw]"
        >
          <img
            src="/images/brand/qrcode.png"
            alt="QR Code"
            class="h-full w-full object-contain"
            draggable="false"
          />
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const PROFILE_CARD_STORAGE_KEY = "profile-card-flipped";

  const setupProfileCard = () => {
    const card = document.querySelector<HTMLElement>("#profile-card");
    const inner = document.querySelector<HTMLElement>("#profile-card-inner");

    if (!card || !inner) return;
    if (card.dataset.initialized === "true") return;
    card.dataset.initialized = "true";

    // 表裏状態の復元
    const savedState = sessionStorage.getItem(PROFILE_CARD_STORAGE_KEY);
    let flipped = savedState === "true";
    inner.style.transform = flipped
      ? "perspective(300cqw) rotateY(180deg)"
      : "perspective(300cqw) rotateY(0deg)";
    inner.dataset.flipped = String(flipped);

    // reduced motion の配慮
    const prefersReduced =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 状態（イージング用）
    let currentX = 0;
    let currentY = 0;
    let currentZ = 0;
    let currentScale = 1;

    let targetX = 0;
    let targetY = 0;
    let targetZ = 0;
    let targetScale = 1;

    let rafId = 0;
    let isAnimating = false;
    const easing = 0.12;

    // カード中心を基準に、マウス位置（比率）から角度を決定する関数
    const updateTargetFromPosition = (clientX: number, clientY: number) => {
      if (prefersReduced) {
        targetX = 0;
        targetY = 0;
        targetZ = 0;
        targetScale = 1;
        return;
      }

      const rect = card.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      // カード内の相対位置： -1 .. 1
      const px = ((clientX - rect.left) / rect.width) * 2 - 1;
      const py = ((clientY - rect.top) / rect.height) * 2 - 1;

      // px, py が中央(0,0) のとき傾き無し。端に行くほど大きく傾く。
      // 値を調整して自然な傾きにする
      const maxRotateX = 6.5; // 上下（縦）方向の最大回転量（deg）
      const maxRotateY = 6.5; // 左右（横）方向の最大回転量（deg）
      const twistFactor = 1.2; // 斜めに捻る量

      // 縦位置 -> rotateX（上下に傾く）: 上に行くほど正の回転（見下ろす）
      targetX = -py * maxRotateX;
      // 横位置 -> rotateY（左右に傾く）: 右に行くほど正の回転
      targetY = px * maxRotateY;
      // 斜めによるわずかなZ回転
      targetZ = px * py * twistFactor;

      // カード中心からの距離により微妙に拡大
      const distance = Math.min(1, Math.sqrt(px * px + py * py));
      targetScale = 1 + distance * 0.012;
    };

    const startAnimation = () => {
      if (isAnimating) return;
      isAnimating = true;
      rafId = requestAnimationFrame(animate);
    };

    const animate = () => {
      currentX += (targetX - currentX) * easing;
      currentY += (targetY - currentY) * easing;
      currentZ += (targetZ - currentZ) * easing;
      currentScale += (targetScale - currentScale) * easing;

      card.style.transform = `
        perspective(250cqw)
        rotateX(${currentX}deg)
        rotateY(${currentY}deg)
        rotateZ(${currentZ}deg)
        scale(${currentScale})
      `;

      const settled =
        Math.abs(targetX - currentX) < 0.02 &&
        Math.abs(targetY - currentY) < 0.02 &&
        Math.abs(targetZ - currentZ) < 0.02 &&
        Math.abs(targetScale - currentScale) < 0.0005;

      if (!settled) {
        rafId = requestAnimationFrame(animate);
      } else {
        // 完全に目標に近づいたら rAF を止める
        isAnimating = false;
        rafId = 0;
      }
    };

    // マウス位置に応じたターゲット更新（位置ベースのみ）
    const handleMouseMove = (e: MouseEvent) => {
      updateTargetFromPosition(e.clientX, e.clientY);
      startAnimation();
    };

    // カード外に出たら元に戻す
    const handleMouseLeave = () => {
      targetX = 0;
      targetY = 0;
      targetZ = 0;
      targetScale = 1;
      startAnimation();
    };

    // クリック（pointerup）で表裏反転（既存のアニメーションを利用）
    const handlePointerUp = (event: PointerEvent) => {
      // マウスの右クリックでは反転しない
      if (event.pointerType === "mouse" && event.button !== 0) {
        return;
      }

      flipped = !flipped;
      inner.dataset.flipped = String(flipped);
      sessionStorage.setItem(PROFILE_CARD_STORAGE_KEY, String(flipped));

      inner.getAnimations().forEach((animation) => {
        animation.cancel();
      });

      const target = flipped ? 180 : 0;
      const start = flipped ? 0 : 180;

      inner.animate(
        [
          {
            transform: `
              perspective(300cqw)
              rotateY(${start}deg)
              rotateX(0deg)
              rotateZ(0deg)
              translateY(0)
              scale(1)
            `,
          },
          {
            transform: `
              perspective(300cqw)
              rotateY(${start + (target - start) * 0.4}deg)
              rotateX(2deg)
              rotateZ(${flipped ? "-0.5deg" : "0.5deg"})
              translateY(-0.75cqw)
              scale(1.02)
            `,
          },
          {
            transform: `
              perspective(300cqw)
              rotateY(${start + (target - start) * 0.58}deg)
              rotateX(-1deg)
              rotateZ(${flipped ? "0.25deg" : "-0.25deg"})
              translateY(-0.5cqw)
              scale(1.015)
            `,
          },
          {
            transform: `
              perspective(300cqw)
              rotateY(${target}deg)
              rotateX(0deg)
              rotateZ(0deg)
              translateY(0)
              scale(1)
            `,
          },
        ],
        {
          duration: 700,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          fill: "forwards",
        }
      );
    };

    // デスクトップ（マウス）向けに mousemove / mouseleave を使う
    card.addEventListener("mousemove", handleMouseMove);
    card.addEventListener("mouseleave", handleMouseLeave);
    card.addEventListener("pointerup", handlePointerUp);

    const cleanup = () => {
      card.removeEventListener("mousemove", handleMouseMove);
      card.removeEventListener("mouseleave", handleMouseLeave);
      card.removeEventListener("pointerup", handlePointerUp);
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
      isAnimating = false;
    };

    window.addEventListener("beforeunload", cleanup);
    document.addEventListener("astro:page-unload", cleanup);
  };

  setupProfileCard();
  document.addEventListener("astro:page-load", setupProfileCard);
</script>
