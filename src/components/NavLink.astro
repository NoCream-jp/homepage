---
// src/components/NavLink.astro
interface Props {
  href: string; // 例: "/#news"
  targetId: string; // 例: "news" (セクションのIDと一致させる)
}

const { href, targetId } = Astro.props;
---

<a
  href={href}
  data-nav-target={targetId}
  class="data-[active=true]:text-primary relative inline-flex items-center justify-center px-1.5 py-4 text-[11px] font-bold tracking-wide uppercase opacity-70 transition-all duration-300 hover:opacity-100 data-[active=true]:opacity-100 sm:px-2 sm:text-xs lg:px-6 lg:py-3 lg:text-base lg:tracking-widest lg:hover:translate-x-1 lg:data-[active=true]:before:absolute lg:data-[active=true]:before:left-0 lg:data-[active=true]:before:content-['・'] lg:data-[active=true]:after:absolute lg:data-[active=true]:after:right-0 lg:data-[active=true]:after:content-['・'] lg:data-[active=true]:hover:translate-x-0"
>
  <slot />
</a>
