---
import RollText from "./RollText.astro";

interface Props {
  href: string;
  targetId: string;
  text: string;
}

const { href, targetId, text } = Astro.props;
---

<!-- classにgroupがないとRollTextが作動しない -->
<a
  href={href}
  data-nav-target={targetId}
  class="group hover:text-primary relative inline-flex items-center justify-center px-1.5 py-4 text-[20px] tracking-wide uppercase opacity-100 transition-all data-[active=true]:opacity-100 sm:px-2 sm:text-base md:border-l md:border-transparent md:px-6 md:py-3 md:text-xl md:tracking-widest md:data-[active=true]:border-black"
>
  <RollText text={text} />
</a>
