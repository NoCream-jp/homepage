---
interface Props {
  href: string;
  targetId: string;
}

const { href, targetId } = Astro.props;
---

<a
  href={href}
  data-nav-target={targetId}
  class="hover:text-primary relative inline-flex items-center justify-center px-1.5 py-4 text-[11px] tracking-wide uppercase opacity-100 transition-all data-[active=true]:opacity-100 sm:px-2 sm:text-xs lg:border-l lg:border-transparent lg:px-6 lg:py-3 lg:text-base lg:tracking-widest lg:data-[active=true]:border-black"
>
  <slot />
</a>
