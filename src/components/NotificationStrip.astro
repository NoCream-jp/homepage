---
const { items = [], speed = 40 } = Astro.props;
const shouldRender = Array.isArray(items) && items.length > 0;

const bannerItem = {
  section: "",
  date: "",
  title: "WHATS NEW",
  href: "#",
  banner: true,
};
---

{
  shouldRender && (
    <nav aria-label="site notifications" class="w-full border-y bg-zinc-50">
      <div class="mx-auto max-w-7xl">
        <div
          class="notif-scroll no-scrollbar relative overflow-x-auto"
          data-speed={speed}
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label="最新のお知らせ"
        >
          <ul class="notif-list flex gap-0 whitespace-nowrap">
            {Array(10)
              .fill([bannerItem, ...items])
              .flat()
              .map((it) => (
                <li
                  class="notif-item inline-flex"
                  role="group"
                  aria-roledescription="notification"
                >
                  {it.banner ? (
                    <div class="notif-banner inline-flex h-12 items-center justify-center border-r bg-[repeating-linear-gradient(45deg,#0000_0px,#0000_6px,#d1d5db_6px,#d1d5db_7px)] px-4 text-black">
                      <span class="text-xs font-semibold tracking-wide">
                        {it.title}
                      </span>
                    </div>
                  ) : (
                    <a
                      href={it.href || null}
                      class="notif-link inline-flex h-12 items-center gap-4 border-r bg-white px-4 py-2"
                      aria-label={`${it.section} ${it.title}`}
                    >
                      <span class="block text-xs tracking-wide text-zinc-600">
                        {it.section}
                      </span>
                      <span class="block text-xs text-zinc-600">
                        {it.date ?? ""}
                      </span>
                      <span class="block text-sm font-medium text-zinc-800">
                        {it.title}
                      </span>
                      {it.href && it.href !== "" && (
                        <span class="ml-3 inline-flex items-center justify-center rounded-full border-none p-1">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4 text-zinc-600"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M5 12h14" />
                            <path d="M12 5l7 7-7 7" />
                          </svg>
                        </span>
                      )}
                    </a>
                  )}
                </li>
              ))}
          </ul>
        </div>
      </div>
    </nav>
  )
}

<style>
  /* Hide scrollbars while still allow scrolling across browsers */
  .no-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none; /* Safari and Chrome */
  }

  /* Make the duplicated list items line up without extra gap */
  .notif-list {
    display: flex;
    align-items: center;
  }
  .notif-item {
    flex: 0 0 auto;
  }
  .notif-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Slight visual tweak: reduce touch-target shrink on small screens */
  .notif-link {
    min-width: 140px;
    box-sizing: ox;
  }

  /* Make keyboard focus visible (ID変数展開の代わりにクラスを使用) */
  .notif-scroll:focus {
    outline: 2px solid rgba(0, 0, 0, 0.06);
    outline-offset: 2px;
  }

  /* WHATS NEW部分 */
  .notif-banner {
    min-width: 140px; /* 他のアイテムと同程度の幅を確保 */
    box-sizing: border-box;
  }
</style>

<script>
  // クライアントサイドでの自動スクロール制御
  // 複数配置されても正常に動くよう querySelectorAll で初期化します
  document.querySelectorAll(".notif-scroll").forEach((el) => {
    // data属性から速度を取得
    const speedPxPerSec = parseFloat(el.getAttribute("data-speed") ?? "40");

    const list = el.querySelector(".notif-list");
    if (!list) return;

    // 半分の幅がコンテナより大きい場合のみスクロールさせる
    function needsScroll() {
      return el.scrollWidth / 2 > el.clientWidth + 1;
    }

    let running = false;
    let lastTime: number | null = null;
    let rafId: number | null = null;
    let paused = false;

    function step(time: number) {
      if (paused) {
        lastTime = time;
        rafId = requestAnimationFrame(step);
        return;
      }

      if (lastTime == null) lastTime = time;
      const dt = (time - lastTime) / 1000;
      lastTime = time;

      el.scrollLeft += speedPxPerSec * dt;

      // 半分（1ループ分）スクロールしたら位置をリセット
      const singleWidth = el.scrollWidth / 2;
      if (el.scrollLeft >= singleWidth) {
        el.scrollLeft -= singleWidth;
      }

      rafId = requestAnimationFrame(step);
    }

    function start() {
      if (running) return;
      // if (!needsScroll()) return;
      running = true;
      lastTime = null;
      rafId = requestAnimationFrame(step);
    }

    function stop() {
      running = false;
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    // Hover / Focus による一時停止
    el.addEventListener("mouseenter", () => {
      paused = true;
    });
    el.addEventListener("mouseleave", () => {
      paused = false;
    });
    el.addEventListener("focusin", () => {
      paused = true;
    });
    el.addEventListener("focusout", () => {
      paused = false;
    });

    let isPointerDown = false;
    el.addEventListener("pointerdown", () => {
      isPointerDown = true;
      paused = true;
    });
    el.addEventListener("pointerup", () => {
      isPointerDown = false;
      paused = false;
    });

    const ro = new ResizeObserver(() => {
      start();
    });
    ro.observe(el);

    start();
  });
</script>
