---
// src/components/DiaryCalendar.astro
// DiaryCalendar — emoji-centered デザイン（構造は変更なし）
// 条件:
// - 日付の数字は消さない
// - 今日の日付はスクリプトでハイライト（既存処理維持）
// - セル中央に emoji のみ大きく表示（視覚的テキストは表示しないが aria-label は残す）

import ChevronButton from "./ChevronButton.astro";

interface MonthData {
  key: string;
  data: Record<string, { text?: string; emoji?: string; photos?: string[] }>;
}

interface Props {
  months: MonthData[];
}

const { months } = Astro.props;

function daysInMonth(y: number, m: number) {
  return new Date(y, m, 0).getDate();
}

function startWeekday(y: number, m: number) {
  return new Date(y, m - 1, 1).getDay();
}

const displayMonths = [...months].reverse();

const monthViews = displayMonths.map((m) => {
  const [yStr, moStr] = m.key.split("_");
  const year = Number(yStr);
  const month = Number(moStr);
  const days = daysInMonth(year, month);
  const start = startWeekday(year, month);

  const cells: Array<null | {
    day: number;
    key: string;
    entry?: { text?: string; emoji?: string; photos?: string[] };
  }> = [];

  for (let i = 0; i < start; i++) {
    cells.push(null);
  }

  for (let d = 1; d <= days; d++) {
    const key = `${year}-${String(month).padStart(2, "0")}-${String(d).padStart(2, "0")}`;

    cells.push({
      day: d,
      key,
      entry: m.data[key],
    });
  }

  return {
    year,
    month,
    cells,
    label: `${year}.${String(month).padStart(2, "0")}`,
  };
});

const labels = monthViews.map((mv) => mv.label);
const initialIndex = Math.max(labels.length - 1, 0);
---

<div
  class="@container flex h-auto w-full flex-col bg-white lg:h-full lg:min-h-0"
  id="calendar-widget"
  data-initial-index={initialIndex}
>
  <div class="z-10 shrink-0 bg-white pb-2">
    <div class="flex items-center justify-between pb-3">
      <ChevronButton
        id="cal-prev"
        direction="left"
        class="h-10 w-10 cursor-pointer rounded-full border p-1 text-black transition-colors hover:border-zinc-600 disabled:pointer-events-none disabled:opacity-0"
        aria-label="前の月"
      />

      <div
        id="cal-month-label"
        class="text-[clamp(14px,0.76cqw,19px)] font-medium text-zinc-700"
        aria-hidden="true"
      >
        {labels[initialIndex] ?? "データなし"}
      </div>

      <ChevronButton
        id="cal-next"
        direction="right"
        class="h-10 w-10 cursor-pointer rounded-full border p-1 text-black transition-colors hover:border-zinc-600 disabled:pointer-events-none disabled:opacity-0"
        aria-label="次の月"
      />
    </div>

    <!-- 曜日ヘッダは簡素に保持（表示文字最小化） -->
    <div
      class="grid grid-cols-7 py-1 text-center text-[clamp(11px,0.76cqw,14px)] font-medium text-zinc-600"
    >
      <div aria-hidden="true">S</div>
      <div aria-hidden="true">M</div>
      <div aria-hidden="true">T</div>
      <div aria-hidden="true">W</div>
      <div aria-hidden="true">T</div>
      <div aria-hidden="true">F</div>
      <div aria-hidden="true">S</div>
    </div>
  </div>

  <div
    class="relative overflow-x-hidden pt-2 lg:min-h-0 lg:flex-1 lg:overflow-hidden"
  >
    <div
      id="cal-track"
      class="flex w-full transition-transform duration-300 ease-out lg:h-full"
      style={`transform: translateX(-${initialIndex * 100}%);`}
    >
      {
        monthViews.map((mv) => (
          <div
            class="calendar-slide no-scrollbar w-full shrink-0 overflow-visible pb-10 lg:h-full lg:overflow-y-auto"
            data-label={mv.label}
          >
            <div class="grid grid-cols-7 gap-1">
              {mv.cells.map((cell) =>
                cell === null ? (
                  <div class="aspect-3/4 rounded bg-zinc-50 md:aspect-square" />
                ) : (
                  <div
                    class="flex aspect-3/4 flex-col overflow-hidden rounded border p-1 md:aspect-square"
                    data-date={cell.key}
                  >
                    <div class="flex shrink-0 justify-start">
                      {/* day-number: 常に表示（モバイル含む）。スクリプトで today にハイライトを付与 */}
                      <div class="day-number flex h-6 w-6 items-center justify-center rounded-full text-[clamp(11px,0.69cqw,12px)] text-zinc-500">
                        {cell.day}
                      </div>

                      <span class="sr-only">日付 {cell.key}</span>
                    </div>

                    <div class="flex min-h-0 flex-1 flex-col justify-center overflow-hidden bg-white pt-[clamp(1px,0.15cqw,5px)] md:mt-2 lg:px-2">
                      {cell.entry ? (
                        /* emoji only を中央に大きく表示するレイアウト */
                        <div
                          role="button"
                          class="relative flex h-full w-full items-center justify-center"
                          aria-label={
                            cell.entry.text
                              ? `${cell.entry.emoji ?? ""} ${cell.entry.text}`
                              : `${cell.entry.emoji ?? ""}`
                          }
                        >
                          <div
                            class="emoji-center leading-none select-none"
                            aria-hidden="true"
                            style="font-size: clamp(20px, 9vw, 44px);"
                          >
                            {cell.entry.emoji ?? ""}
                          </div>
                        </div>
                      ) : (
                        <div class="flex h-full items-center justify-center">
                          <div
                            class="text-[clamp(9px,0.69cqw,13px)] text-zinc-200"
                            aria-hidden="true"
                          >
                            —
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                )
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  /* 型エラーの原因である 'Element' に対する dataset 参照を避けるため
     instanceof HTMLElement チェックを多用し、TypeScript 型警告が出ないようにしています。
     today のハイライト処理は day-number 要素に作用します（常に日付を表示するため動作します）。
     既存の月移動 / session 保存などのロジックは維持しています。 */

  const setupCalendar = () => {
    const widgetEl = document.getElementById("calendar-widget");
    if (!widgetEl || !(widgetEl instanceof HTMLElement)) return;
    const widget = widgetEl as HTMLElement;

    // 初期化済みチェック（datasetへのアクセスは HTMLElement で安全）
    if (widget.dataset.initialized === "true") return;
    widget.dataset.initialized = "true";

    // cal-track / label / prev / next / slides を安全に取得
    const trackEl = widget.querySelector("#cal-track");
    if (!trackEl || !(trackEl instanceof HTMLElement)) return;
    const track = trackEl as HTMLElement;

    const labelEl = widget.querySelector("#cal-month-label");
    if (!labelEl || !(labelEl instanceof HTMLElement)) return;
    const label = labelEl as HTMLElement;

    const prevEl = widget.querySelector("#cal-prev");
    const nextEl = widget.querySelector("#cal-next");

    const prev =
      prevEl && prevEl instanceof HTMLElement
        ? (prevEl as HTMLButtonElement)
        : null;
    const next =
      nextEl && nextEl instanceof HTMLElement
        ? (nextEl as HTMLButtonElement)
        : null;

    const slideNodes = Array.from(widget.querySelectorAll(".calendar-slide"));
    const slides = slideNodes.filter(
      (s) => s instanceof HTMLElement
    ) as HTMLElement[];

    if (!track || !label || slides.length === 0) return;

    // --- ブラウザの現在時刻から「今日」を判定 ---
    const now = new Date();
    const currentYear = now.getFullYear();
    const currentMonth = now.getMonth() + 1;
    const currentDay = now.getDate();

    const currentMonthLabel = `${currentYear}.${String(currentMonth).padStart(2, "0")}`;

    const todayStr = `${currentYear}-${String(currentMonth).padStart(2, "0")}-${String(currentDay).padStart(2, "0")}`;

    // 「今日」のセルをクライアント側でハイライト
    const todayCellGeneric = widget.querySelector(`[data-date="${todayStr}"]`);
    if (todayCellGeneric && todayCellGeneric instanceof HTMLElement) {
      const todayCell = todayCellGeneric as HTMLElement;
      todayCell.dataset.today = "true";

      const numberElGeneric = todayCell.querySelector(".day-number");
      if (numberElGeneric && numberElGeneric instanceof HTMLElement) {
        const numberEl = numberElGeneric as HTMLElement;
        numberEl.classList.remove("text-zinc-500");
        numberEl.classList.add("bg-cyan-700", "text-white");
      }
    }

    const initialIndexAttr = parseInt(widget.dataset.initialIndex || "0", 10);

    let currentIndex = Math.max(
      0,
      Math.min(initialIndexAttr, slides.length - 1)
    );

    const savedIndex = sessionStorage.getItem("calendar-current-index");

    let navType = "navigate";

    try {
      const entries =
        performance.getEntriesByType &&
        performance.getEntriesByType("navigation");

      if (
        entries &&
        entries.length > 0 &&
        (entries[0] as PerformanceNavigationTiming).type
      ) {
        navType = (entries[0] as PerformanceNavigationTiming).type;
      } else if (
        (performance as any).navigation &&
        typeof (performance as any).navigation.type === "number"
      ) {
        const t = (performance as any).navigation.type;
        navType = t === 1 ? "reload" : t === 2 ? "back_forward" : "navigate";
      }
    } catch (e) {
      // ignore
    }

    const currentMonthIndex = slides.findIndex(
      (s) => s.dataset.label === currentMonthLabel
    );

    if (savedIndex !== null && navType === "back_forward") {
      const idx = parseInt(savedIndex, 10);

      if (!Number.isNaN(idx)) {
        currentIndex = Math.max(0, Math.min(idx, slides.length - 1));
      }
    } else {
      if (currentMonthIndex !== -1) {
        currentIndex = currentMonthIndex;
      } else {
        currentIndex = Math.max(
          0,
          Math.min(initialIndexAttr, slides.length - 1)
        );
      }
    }

    const updateView = (opts = { save: true, scrollToday: false }) => {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      const currentSlide = slides[currentIndex];

      if (currentSlide && currentSlide.dataset.label) {
        label.textContent = currentSlide.dataset.label;
      }

      if (prev) {
        prev.disabled = currentIndex === 0;
      }

      if (next) {
        next.disabled = currentIndex === slides.length - 1;
      }

      if (opts.save) {
        sessionStorage.setItem("calendar-current-index", String(currentIndex));
      }

      if (
        opts.scrollToday &&
        window.matchMedia("(min-width: 1024px)").matches
      ) {
        const currentSlideEl = slides[currentIndex];

        if (currentSlideEl) {
          const todayElGeneric = currentSlideEl.querySelector(
            '[data-today="true"]'
          );
          if (todayElGeneric && todayElGeneric instanceof HTMLElement) {
            const todayEl = todayElGeneric as HTMLElement;
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                try {
                  todayEl.scrollIntoView({
                    block: "center",
                    behavior: "smooth",
                  });
                } catch (e) {
                  todayEl.scrollIntoView();
                }
              });
            });
          }
        }
      }
    };

    if (prev) {
      prev.addEventListener("click", () => {
        currentIndex = Math.max(currentIndex - 1, 0);

        updateView({
          save: true,
          scrollToday: false,
        });
      });
    }

    if (next) {
      next.addEventListener("click", () => {
        currentIndex = Math.min(currentIndex + 1, slides.length - 1);

        updateView({
          save: true,
          scrollToday: false,
        });
      });
    }

    window.addEventListener("popstate", () => {
      const s = sessionStorage.getItem("calendar-current-index");

      if (s !== null) {
        const idx = parseInt(s, 10);

        if (!Number.isNaN(idx)) {
          currentIndex = Math.max(0, Math.min(idx, slides.length - 1));
        } else {
          currentIndex = Math.max(
            0,
            Math.min(initialIndexAttr, slides.length - 1)
          );
        }
      } else {
        currentIndex = Math.max(
          0,
          Math.min(initialIndexAttr, slides.length - 1)
        );
      }

      updateView({
        save: true,
        scrollToday: false,
      });
    });

    window.addEventListener("pageshow", (ev) => {
      const evAny = ev as any;
      if (evAny && evAny.persisted) {
        const s = sessionStorage.getItem("calendar-current-index");

        if (s !== null) {
          const idx = parseInt(s, 10);

          if (!Number.isNaN(idx)) {
            currentIndex = Math.max(0, Math.min(idx, slides.length - 1));
          }
        }

        updateView({
          save: true,
          scrollToday: false,
        });
      } else {
        if (navType === "reload") {
          if (currentMonthIndex !== -1) {
            currentIndex = currentMonthIndex;
          } else {
            currentIndex = Math.max(
              0,
              Math.min(initialIndexAttr, slides.length - 1)
            );
          }

          updateView({
            save: true,
            scrollToday: false,
          });
        }
      }
    });

    updateView({
      save: true,
      scrollToday: false,
    });
  };

  // 初期化呼び出しと Astro ナビゲーションフック
  setupCalendar();
  document.addEventListener("astro:page-load", setupCalendar);
</script>
