---
import ChevronButton from "./ChevronButton.astro";

interface MonthData {
  key: string;
  data: Record<string, { text?: string; emoji?: string }>;
}

interface Props {
  months: MonthData[];
}

const { months } = Astro.props;

function daysInMonth(y: number, m: number) {
  return new Date(y, m, 0).getDate();
}
function startWeekday(y: number, m: number) {
  return new Date(y, m - 1, 1).getDay();
}

const now = new Date();
const currentYear = now.getFullYear();
const currentMonth = now.getMonth() + 1;
const currentDay = now.getDate();

const displayMonths = [...months].reverse();

const monthViews = displayMonths.map((m) => {
  const [yStr, moStr] = m.key.split("_");
  const year = Number(yStr);
  const month = Number(moStr);
  const days = daysInMonth(year, month);
  const start = startWeekday(year, month);

  const isCurrentMonth = currentYear === year && currentMonth === month;
  const today = isCurrentMonth ? currentDay : -1;

  const cells = [];
  for (let i = 0; i < start; i++) cells.push(null);

  for (let d = 1; d <= days; d++) {
    const key = `${year}-${String(month).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    cells.push({
      day: d,
      key,
      entry: m.data[key],
      isToday: d === today,
    });
  }

  return {
    year,
    month,
    cells,
    label: `${year}.${String(month).padStart(2, "0")}`,
  };
});

const labels = monthViews.map((mv) => mv.label);
const initialIndex = Math.max(labels.length - 1, 0);
---

<div
  class="flex h-full w-full flex-col bg-white"
  id="calendar-widget"
  data-initial-index={initialIndex}
>
  <div class="z-10 shrink-0 bg-white pb-2">
    <div class="flex items-center justify-between pb-3">
      <ChevronButton
        id="cal-prev"
        direction="left"
        class="h-10 w-10 cursor-pointer rounded-full border p-1 text-black transition-colors hover:border-zinc-600 disabled:pointer-events-none disabled:opacity-0"
        aria-label="前の月"
      />

      <div id="cal-month-label" class="text-sm font-medium text-zinc-700">
        {labels[initialIndex] ?? "データなし"}
      </div>

      <ChevronButton
        id="cal-next"
        direction="right"
        class="h-10 w-10 cursor-pointer rounded-full border p-1 text-black transition-colors hover:border-zinc-600 disabled:pointer-events-none disabled:opacity-0"
        aria-label="次の月"
      />
    </div>

    <div
      class="grid grid-cols-7 py-1 text-center text-[11px] font-medium text-zinc-600"
    >
      <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div
      >
        Fri
      </div><div>Sat</div>
    </div>
  </div>

  <div class="relative min-h-0 flex-1 overflow-hidden pt-2">
    <div
      id="cal-track"
      class="flex h-full w-full transition-transform duration-300 ease-out"
      style={`transform: translateX(-${initialIndex * 100}%);`}
    >
      {
        monthViews.map((mv) => (
          <div
            class="calendar-slide no-scrollbar h-full w-full shrink-0 overflow-y-auto pb-10"
            data-label={mv.label}
          >
            <div class="grid grid-cols-7 gap-1">
              {mv.cells.map((cell) =>
                cell === null ? (
                  <div class="aspect-square rounded bg-zinc-50" />
                ) : (
                  <div
                    class="flex aspect-square flex-col overflow-hidden rounded border p-1"
                    data-today={cell.isToday ? "true" : "false"}
                  >
                    <div class="flex shrink-0 justify-start">
                      <div
                        class={`flex h-6 w-6 items-center justify-center rounded-full text-[10px] ${
                          cell.isToday
                            ? "bg-cyan-700 text-white"
                            : "text-zinc-500"
                        }`}
                      >
                        {cell.day}
                      </div>
                    </div>

                    <div class="mt-1 flex min-h-0 flex-1 flex-col justify-start overflow-hidden bg-white lg:pt-4">
                      {cell.entry ? (
                        <div class="line-clamp-3 text-[11px] leading-tight wrap-break-word">
                          {cell.entry.emoji ?? ""} {cell.entry.text}
                        </div>
                      ) : (
                        <div class="text-[10px] text-zinc-300">—</div>
                      )}
                    </div>
                  </div>
                )
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  const setupCalendar = () => {
    const widget = document.getElementById("calendar-widget");
    if (!widget || widget.dataset.initialized === "true") return;
    widget.dataset.initialized = "true";

    // --- 型注釈 ---
    const track = widget.querySelector<HTMLElement>("#cal-track");
    const label = widget.querySelector<HTMLElement>("#cal-month-label");
    const prev = widget.querySelector<HTMLButtonElement>("#cal-prev");
    const next = widget.querySelector<HTMLButtonElement>("#cal-next");
    const slides = widget.querySelectorAll<HTMLElement>(".calendar-slide");
    // --------------------

    if (!track || !label || slides.length === 0) return;

    const initialIndexAttr = parseInt(widget.dataset.initialIndex || "0", 10);

    const now = new Date();
    const currentYear = now.getFullYear();
    const currentMonth = now.getMonth() + 1;
    const currentMonthLabel = `${currentYear}.${String(currentMonth).padStart(2, "0")}`;

    // savedIndex が有り、かつ戻る/進むで復帰している場合は saved を優先
    let currentIndex = Math.max(
      0,
      Math.min(initialIndexAttr, slides.length - 1)
    );
    const savedIndex = sessionStorage.getItem("calendar-current-index");

    // ブラウザのナビタイプ判定（navigate | reload | back_forward）
    let navType = "navigate";
    try {
      const entries =
        performance.getEntriesByType &&
        performance.getEntriesByType("navigation");
      if (
        entries &&
        entries.length > 0 &&
        (entries[0] as PerformanceNavigationTiming).type
      ) {
        navType = (entries[0] as PerformanceNavigationTiming).type;
      } else if (
        (performance as any).navigation &&
        typeof (performance as any).navigation.type === "number"
      ) {
        const t = (performance as any).navigation.type;
        navType = t === 1 ? "reload" : t === 2 ? "back_forward" : "navigate";
      }
    } catch (e) {
      // ignore
    }

    // index of current month slide if exists
    const slidesArr = Array.from(slides);
    const currentMonthIndex = slidesArr.findIndex(
      (s) => s.dataset.label === currentMonthLabel
    );

    if (savedIndex !== null && navType === "back_forward") {
      const idx = parseInt(savedIndex, 10);
      if (!Number.isNaN(idx))
        currentIndex = Math.max(0, Math.min(idx, slides.length - 1));
    } else {
      // 通常の初回表示またはリロード：現在月があれば優先して表示（「今日に戻る」要件）
      if (currentMonthIndex !== -1) {
        currentIndex = currentMonthIndex;
      } else {
        currentIndex = Math.max(
          0,
          Math.min(initialIndexAttr, slides.length - 1)
        );
      }
    }

    const updateView = (opts = { save: true, scrollToday: false }) => {
      if (track) track.style.transform = `translateX(-${currentIndex * 100}%)`;

      const currentSlide = slides[currentIndex];
      if (currentSlide && currentSlide.dataset.label) {
        label.textContent = currentSlide.dataset.label;
      }

      if (prev) prev.disabled = currentIndex === 0;
      if (next) next.disabled = currentIndex === slides.length - 1;

      if (opts.save) {
        sessionStorage.setItem("calendar-current-index", String(currentIndex));
      }

      if (opts.scrollToday) {
        // レイアウトが固まってからスクロールする（二重 rAF で安定化）
        const currentSlideEl = slides[currentIndex];
        if (currentSlideEl) {
          const todayEl = currentSlideEl.querySelector<HTMLElement>(
            '[data-today="true"]'
          );
          if (todayEl) {
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                // use smooth on initial display; if you prefer instant use behavior: 'auto'
                try {
                  todayEl.scrollIntoView({
                    block: "center",
                    behavior: "smooth",
                  });
                } catch (e) {
                  // 一部ブラウザでオプションがエラーになる可能性に備える
                  todayEl.scrollIntoView();
                }
              });
            });
          }
        }
      }
    };

    if (prev) {
      prev.addEventListener("click", () => {
        currentIndex = Math.max(currentIndex - 1, 0);
        updateView({ save: true, scrollToday: false });
      });
    }

    if (next) {
      next.addEventListener("click", () => {
        currentIndex = Math.min(currentIndex + 1, slides.length - 1);
        updateView({ save: true, scrollToday: false });
      });
    }

    window.addEventListener("popstate", () => {
      const s = sessionStorage.getItem("calendar-current-index");
      if (s !== null) {
        const idx = parseInt(s, 10);
        if (!Number.isNaN(idx)) {
          currentIndex = Math.max(0, Math.min(idx, slides.length - 1));
        } else {
          currentIndex = Math.max(
            0,
            Math.min(initialIndexAttr, slides.length - 1)
          );
        }
      } else {
        currentIndex = Math.max(
          0,
          Math.min(initialIndexAttr, slides.length - 1)
        );
      }
      updateView({ save: true, scrollToday: true });
    });

    window.addEventListener("pageshow", (ev) => {
      if (ev && (ev as PageTransitionEvent).persisted) {
        const s = sessionStorage.getItem("calendar-current-index");
        if (s !== null) {
          const idx = parseInt(s, 10);
          if (!Number.isNaN(idx))
            currentIndex = Math.max(0, Math.min(idx, slides.length - 1));
        }
        updateView({ save: true, scrollToday: true });
      } else {
        // reload のときは今日優先（navType 判定により）
        if (navType === "reload") {
          if (currentMonthIndex !== -1) {
            currentIndex = currentMonthIndex;
          } else {
            currentIndex = Math.max(
              0,
              Math.min(initialIndexAttr, slides.length - 1)
            );
          }
          updateView({ save: true, scrollToday: true });
        }
      }
    });

    // 初回表示：今日が含まれるスライドに移動し、今日要素をスクロールする
    updateView({ save: true, scrollToday: true });
  };

  setupCalendar();
  document.addEventListener("astro:page-load", setupCalendar);
</script>
