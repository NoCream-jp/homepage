---
interface Props {
  date: Date;
  title: string;
  category?: string; // 現時点では利用しない
  href: string;
}

const { date, title, href } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<a
  href={href}
  class="group flex cursor-pointer flex-col gap-1 py-1 transition-opacity sm:flex-row sm:items-center sm:gap-12"
>
  <time class="text-label w-28 shrink-0 tracking-widest tabular-nums">
    {formattedDate}
  </time>
  <div
    class="group-hover:text-primary min-w-0 flex-1 text-base text-black transition-colors sm:text-lg"
  >
    {title}
  </div>
</a>
