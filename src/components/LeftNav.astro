---
// src/components/LeftNav.astro
import BuisinessCard from "./BuisinessCard.astro";
import LinkCard from "./LinkCard.astro";

const pathname = Astro.url.pathname;

const navigation = [
  { label: "home", href: "/" },
  { label: "blog", href: "/blog" },
  { label: "bio", href: "/bio" },
  { label: "work", href: "/work" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<div id="leftnav" class="flex flex-col" style="gap:1.75rem">
  <nav
    class="flex w-full max-w-100 items-center gap-1"
    aria-label="page navigation"
  >
    {
      navigation.map((item) => {
        const active = isActive(item.href);

        return (
          <a
            href={item.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "relative flex-1 rounded-md px-2 py-2 text-center text-sm transition-colors",
              active ? "text-zinc-900" : "text-zinc-500 hover:text-zinc-900",
            ]}
          >
            {item.label}
            {active && (
              <span
                aria-hidden="true"
                transition:name="nav-active-border"
                class="pointer-events-none absolute inset-0 rounded-md border"
              />
            )}
          </a>
        );
      })
    }
  </nav>

  <div class="hidden lg:block">
    <BuisinessCard
      name="Minato Hayashi"
      age="23+"
      location="Osaka, Japan"
      pronoun="He / Him"
      study="reinforcement learning"
    />
  </div>

  <div class="hidden w-full max-w-100 grid-cols-2 gap-1 lg:grid">
    <LinkCard
      title="GitHub"
      username="NoCream-jp"
      href="https://github.com/NoCream-jp"
    />
    <LinkCard title="X" username="Cafe" href="https://x.com/sXMN1au45a68174" />
    <LinkCard
      title="LinkedIn"
      username="Minato Hayashi"
      href="https://www.linkedin.com/in/m-hayashi/"
    />
    <LinkCard title="Instagram" href="https://www.instagram.com/koshi2055" />
    <LinkCard
      title="AtCoder"
      username="Caffeineholic"
      href="https://atcoder.jp/users/Caffeineholic"
    />
    <LinkCard title="can i put address here" disabled />
  </div>
</div>

<script>
  (function () {
    if (typeof document === "undefined") return;
    const el = document.getElementById("leftnav");
    if (!el) return;

    const R = 0.04,
      MIN = 8,
      MAX = 36; // 小さめの上限でコンパクトに
    const getH = () =>
      (el.parentElement && el.parentElement.clientHeight) || innerHeight;
    const apply = () => {
      const g = Math.round(Math.max(MIN, Math.min(MAX, getH() * R)));
      if (el.style.gap !== g + "px") el.style.gap = g + "px";
    };

    let raf: number | null = null;
    const upd = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        apply();
        raf = null;
      });
    };

    apply();
    addEventListener("resize", upd, { passive: true });
    if (typeof ResizeObserver !== "undefined") {
      try {
        new ResizeObserver(upd).observe(el.parentElement || el);
      } catch (e) {}
    }
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") upd();
    });
    addEventListener("unload", () => {
      removeEventListener("resize", upd);
      document.removeEventListener("visibilitychange", upd);
    });
  })();
</script>
