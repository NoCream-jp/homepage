---
import BuisinessCard from "./BuisinessCard.astro";
import LinkCard from "./LinkCard.astro";

const pathname = Astro.url.pathname;

const navigation = [
  { label: "home", href: "/" },
  { label: "blog", href: "/blog" },
  { label: "bio", href: "/bio" },
  { label: "work", href: "/work" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<!-- 全体 -->
<div
  id="leftnav"
  data-leftnav-panel
  class="flex h-full flex-col justify-center gap-4"
>
  <div class="flex items-center justify-between gap-5">
    <!-- ナビゲーション部分 -->
    <nav
      class="flex min-w-0 flex-1 items-center gap-1"
      aria-label="page navigation"
    >
      {
        navigation.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex-1 rounded-md border px-2 py-2 text-center text-sm transition-colors",
                active
                  ? "bg-primary text-inverse border-transparent"
                  : "bg-surface text-secondary hover:border-accent hover:text-accent border-(--site-border)",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- 折りたたみボタン -->
    <div class="flex shrink-0 items-center gap-1">
      <button
        data-leftnav-collapse
        type="button"
        class="bg-site-canvas text-secondary hover:text-accent focus-visible:outline-focus hidden size-9 shrink-0 cursor-pointer items-center justify-center rounded-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
        aria-label="Collapse navigation"
        aria-controls="leftnav"
        aria-expanded="true"
      >
        <svg
          aria-hidden="true"
          class="size-9"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
          <path d="M9 3v18"></path>
        </svg>
        <span class="sr-only">Collapse navigation</span>
      </button>

      <!-- テーマ切り替えボタン -->
      <button
        data-theme-toggle
        type="button"
        class="bg-surface text-secondary hover:text-accent hover:border-accent flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-(--site-border) transition-colors lg:hidden"
        aria-label="Switch to dark theme"
        aria-pressed="false"
      >
        <svg
          data-theme-sun
          aria-hidden="true"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
        >
          <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <svg
          data-theme-moon
          aria-hidden="true"
          class="hidden size-5"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8Z"></path>
        </svg>
        <span class="sr-only">Toggle color theme</span>
      </button>
    </div>
  </div>

  <!-- 名刺部分 -->
  <div class="hidden lg:block">
    <BuisinessCard
      name="Minato Hayashi"
      birthYear="2003"
      location="Osaka, Japan"
      pronoun="He / Him"
      study="reinforcement learning"
    />
  </div>

  <!-- 下部のリンクカードのグリッド部分 -->
  <div class="hidden w-full max-w-100 grid-cols-2 gap-1 lg:grid">
    <LinkCard
      title="GitHub"
      username="NoCream-jp"
      href="https://github.com/NoCream-jp"
    />
    <LinkCard title="X" username="Cafe" href="https://x.com/sXMN1au45a68174" />
    <LinkCard
      title="LinkedIn"
      username="Minato Hayashi"
      href="https://www.linkedin.com/in/m-hayashi/"
    />
    <LinkCard title="Instagram" href="https://www.instagram.com/koshi2055" />
    <LinkCard
      title="AtCoder account"
      username="Caffeineholic"
      href="https://atcoder.jp/users/Caffeineholic"
    />

    <div class="flex w-full items-center justify-end gap-1">
      <a
        href="/cli"
        class="group bg-surface text-secondary hover:border-accent hover:text-accent flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-(--site-border) transition-colors"
        aria-label="Open CLI"
      >
        <svg
          aria-hidden="true"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m8 9-3 3 3 3"></path>
          <path d="m16 9 3 3-3 3"></path>
          <path d="m14 5-4 14"></path>
        </svg>
      </a>
      <button
        data-theme-toggle
        type="button"
        class="bg-surface text-secondary hover:border-accent hover:text-accent flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-(--site-border) transition-colors"
        aria-label="Switch to dark theme"
        aria-pressed="false"
      >
        <svg
          data-theme-sun
          aria-hidden="true"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
        >
          <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <svg
          data-theme-moon
          aria-hidden="true"
          class="hidden size-5"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8Z"></path>
        </svg>
        <span class="sr-only">Toggle color theme</span>
      </button>
    </div>
  </div>
</div>

<!-- 展開ボタン -->
<button
  data-leftnav-expand
  type="button"
  class="bg-site-canvas text-secondary hover:text-accent focus-visible:outline-focus absolute top-1/2 left-0 z-20 hidden size-9 shrink-0 -translate-y-1/2 cursor-pointer items-center justify-center rounded-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
  aria-label="Expand navigation"
  aria-controls="leftnav"
  aria-expanded="false"
>
  <svg
    aria-hidden="true"
    class="size-9"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
    <path d="M9 3v18"></path>
  </svg>
  <span class="sr-only">Expand navigation</span>
</button>

<!-- ナビ折りたたみボタン -->
<script>
  const LEFTNAV_COLLAPSED_KEY = "leftnav-collapsed";
  let cleanupLeftNav: (() => void) | undefined;

  const setupLeftNav = () => {
    cleanupLeftNav?.();

    const panel = document.querySelector<HTMLElement>("[data-leftnav-panel]");
    const aside = panel?.closest<HTMLElement>("[data-leftnav-aside]");
    const collapseButton = panel?.querySelector<HTMLButtonElement>(
      "[data-leftnav-collapse]"
    );
    const expandButton = aside?.querySelector<HTMLButtonElement>(
      "[data-leftnav-expand]"
    );

    if (!panel || !aside || !collapseButton || !expandButton) return;

    const desktopQuery = window.matchMedia("(min-width: 64rem)");
    let collapsed = false;

    try {
      collapsed = sessionStorage.getItem(LEFTNAV_COLLAPSED_KEY) === "true";
    } catch {}

    const render = () => {
      const shouldCollapse = desktopQuery.matches && collapsed;

      aside.classList.toggle("lg:w-110", !shouldCollapse);
      aside.classList.toggle("lg:w-0", shouldCollapse);
      aside.classList.toggle("lg:px-5", !shouldCollapse);
      aside.classList.toggle("lg:p-0", shouldCollapse);
      aside.classList.toggle("lg:gap-5", !shouldCollapse);
      aside.classList.toggle("lg:gap-0", shouldCollapse);

      panel.classList.toggle("hidden", shouldCollapse);
      panel.setAttribute("aria-hidden", String(shouldCollapse));
      panel.toggleAttribute("inert", shouldCollapse);

      collapseButton.classList.toggle("hidden", !desktopQuery.matches);
      collapseButton.classList.toggle("flex", desktopQuery.matches);
      expandButton.classList.toggle("hidden", !shouldCollapse);
      expandButton.classList.toggle("flex", shouldCollapse);
      collapseButton.setAttribute("aria-expanded", String(!shouldCollapse));
      expandButton.setAttribute("aria-expanded", String(!shouldCollapse));
    };

    const setCollapsed = (next: boolean, restoreFocus = false) => {
      collapsed = next;

      try {
        sessionStorage.setItem(LEFTNAV_COLLAPSED_KEY, String(next));
      } catch {}

      render();

      if (restoreFocus) {
        (next ? expandButton : collapseButton).focus();
      }
    };

    const handleCollapse = () => setCollapsed(true, true);
    const handleExpand = () => setCollapsed(false, true);
    const handleViewportChange = () => render();

    collapseButton.addEventListener("click", handleCollapse);
    expandButton.addEventListener("click", handleExpand);
    desktopQuery.addEventListener("change", handleViewportChange);

    render();

    cleanupLeftNav = () => {
      collapseButton.removeEventListener("click", handleCollapse);
      expandButton.removeEventListener("click", handleExpand);
      desktopQuery.removeEventListener("change", handleViewportChange);
      cleanupLeftNav = undefined;
    };
  };

  setupLeftNav();
  document.addEventListener("astro:page-load", setupLeftNav);
</script>

<!-- テーマ切り替えボタン -->
<script>
  const setupThemeToggle = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      "[data-theme-toggle]"
    );
    const root = document.documentElement;

    const renderTheme = () => {
      const isDark = root.dataset.theme === "dark";

      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", String(isDark));
        button.setAttribute(
          "aria-label",
          isDark ? "Switch to light theme" : "Switch to dark theme"
        );

        const sunIcon = button.querySelector("[data-theme-sun]");
        const moonIcon = button.querySelector("[data-theme-moon]");
        sunIcon?.classList.toggle("hidden", isDark);
        moonIcon?.classList.toggle("hidden", !isDark);
      });
    };

    buttons.forEach((button) => {
      if (button.dataset.themeToggleBound === "true") return;
      button.dataset.themeToggleBound = "true";

      button.addEventListener("click", () => {
        const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = nextTheme;

        try {
          localStorage.setItem("theme", nextTheme);
        } catch {}

        renderTheme();
      });
    });

    renderTheme();
  };

  setupThemeToggle();
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>

<!-- hoverに応じて傾ける -->
<script>
  (function () {
    if (typeof document === "undefined") return;

    const RATIO = 0.04; // 親高さに対する割合
    const MIN = 2; // 最小 gap(px)
    const MAX = 50; // 最大 gap(px)
    const BOTTOM_BUFFER = 8; // フッターとの余裕(px)
    const STORAGE_KEY = "leftnav-gap";

    // ==========================================
    // 1. スタイル即時適用
    // ==========================================
    function applySavedGap() {
      const el = document.getElementById("leftnav");
      if (!el) return;
      try {
        const saved = sessionStorage.getItem(STORAGE_KEY);
        if (saved !== null) {
          el.style.gap = saved + "px";
          el.style.transition = "none";
        }
      } catch (e) {}
    }

    // 初回マウント時
    applySavedGap();

    // ページ遷移時
    // 新しいDOMに入れ替わった直後、画面に描画される"前"に適用し、チラつきを完全に防ぎます
    document.addEventListener("astro:after-swap", applySavedGap);

    // ==========================================
    // 2. ギャップ計算ロジック
    // ==========================================
    function footerHeight() {
      const f = document.querySelector("footer");
      return f instanceof HTMLElement ? f.offsetHeight : 0;
    }

    function visibleChildren(root: HTMLElement) {
      return Array.from(root.children).filter(
        (c) => c instanceof HTMLElement && c.offsetParent !== null
      );
    }

    function calcClampByParent(parentH: number) {
      return Math.round(Math.max(MIN, Math.min(MAX, parentH * RATIO)));
    }

    function computeAndApply() {
      const el = document.getElementById("leftnav");
      if (!el) return;

      const parent = el.parentElement;
      const parentH = (parent && parent.clientHeight) || window.innerHeight;
      const baseGap = calcClampByParent(parentH);

      const childs = visibleChildren(el);
      const n = childs.length;
      const totalChildH = childs.reduce(
        (s, c) => s + (c instanceof HTMLElement ? c.offsetHeight : 0),
        0
      );
      const avail = Math.max(
        0,
        window.innerHeight -
          footerHeight() -
          el.getBoundingClientRect().top -
          BOTTOM_BUFFER
      );

      let gap = baseGap;
      if (totalChildH + (n - 1) * baseGap > avail) {
        const computed = Math.floor((avail - totalChildH) / Math.max(1, n - 1));
        gap = Math.max(MIN, Math.min(baseGap, computed));
      }

      const gapStr = gap + "px";
      if (el.style.gap !== gapStr) el.style.gap = gapStr;
      try {
        sessionStorage.setItem(STORAGE_KEY, String(gap));
      } catch (e) {}

      if (el.style.transition === "none") {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            el.style.transition = "";
          });
        });
      }
    }

    let raf: number | null = null;
    function schedule() {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        computeAndApply();
        raf = null;
      });
    }

    // ==========================================
    // 3. イベントリスナー管理
    // ==========================================
    window.addEventListener("resize", schedule, { passive: true });
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") schedule();
    });

    let ro: ResizeObserver | null = null;

    document.addEventListener("astro:page-load", () => {
      const el = document.getElementById("leftnav");
      if (!el) return;

      // 前回の Observer が残っていれば解除
      if (ro) ro.disconnect();

      if (typeof ResizeObserver !== "undefined") {
        try {
          ro = new ResizeObserver(schedule);
          ro.observe(el);
          if (el.parentElement) ro.observe(el.parentElement);
        } catch (e) {}
      }

      schedule();
    });
  })();
</script>
