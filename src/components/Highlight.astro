---
interface Props {
  // 任意のカラーコード（例: "#fef08a", "#ffb6c1", "rgba(56, 189, 248, 0.5)" など）
  color?: string;
}

// デフォルトの色を元の黄色（#fef08a）に設定
const { color = "#fef08a" } = Astro.props;
---

<span
  class="px-1 font-bold"
  style={`background: linear-gradient(transparent 70%, ${color} 70%);`}
>
  <slot />
</span>
