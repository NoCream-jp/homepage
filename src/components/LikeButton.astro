---
interface Props {
  articleId: string;
}

const { articleId } = Astro.props;
---

<div class="flex w-fit items-center gap-3">
  <!-- アイコンボタン（円） -->
  <button
    type="button"
    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-zinc-300 bg-white text-lg leading-none transition-all duration-150 hover:bg-zinc-100 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50"
    data-like-button
    data-article-id={articleId}
  >
    <span aria-hidden="true">♡</span>
  </button>

  <!-- ラベル -->
  <span class="text-sm">いいね</span>

  <!-- カウント -->
  <span class="min-w-6 text-sm tabular-nums" data-like-count> 0 </span>
</div>

<script is:inline>
  function initLikeButtons() {
    const roots = document.querySelectorAll("[data-like-root]");

    roots.forEach((root) => {
      if (root.dataset.likeInit === "true") return;
      root.dataset.likeInit = "true";

      const articleId = root.dataset.articleId ?? "";
      if (!articleId) return;

      const button = root.querySelector("[data-like-button]");
      const countElement = root.querySelector("[data-like-count]");

      if (!(button instanceof HTMLButtonElement)) return;
      if (!(countElement instanceof HTMLElement)) return;

      async function loadLikes() {
        try {
          const res = await fetch(`/api/likes/${articleId}`);
          if (!res.ok) return;

          const data = await res.json();
          countElement.textContent = String(data.count);
        } catch (e) {
          console.error(e);
        }
      }

      button.addEventListener("click", async () => {
        if (button.disabled) return;

        button.disabled = true;

        try {
          const res = await fetch(`/api/likes/${articleId}`, {
            method: "POST",
          });

          if (!res.ok) return;

          const data = await res.json();
          countElement.textContent = String(data.count);
        } catch (e) {
          console.error(e);
        } finally {
          button.disabled = false;
        }
      });

      loadLikes();
    });
  }

  // 初回
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLikeButtons);
  } else {
    initLikeButtons();
  }

  // Astro遷移対応（これ超重要）
  document.addEventListener("astro:page-load", initLikeButtons);
</script>
