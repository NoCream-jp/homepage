---
import type { CollectionEntry } from "astro:content";
import QuiltCard from "./QuiltCard.astro";

interface Props {
  achievements: CollectionEntry<"achievement">[];
}

const { achievements } = Astro.props;

// どのカードを大きくするか決めるロジック（例：5個おき、かつ最初）
const isBigPattern = (index: number) => {
  return index % 6 === 0;
};
---

<div
  class="grid grid-cols-1 gap-2 px-15 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
>
  {
    achievements.map((item, index) => (
      <QuiltCard achievement={item} isBig={isBigPattern(index)} />
    ))
  }
</div>

<style>
  /* グリッドが崩れないよう、ブラウザに隙間を埋めさせる */
  .grid {
    grid-auto-flow: dense;
  }
</style>
