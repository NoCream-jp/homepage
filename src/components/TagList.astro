---
// src/components/TagList.astro
interface Props {
  tags?: string[] | null;
  // 常に表示するタグ個数（compact時の個数）。通常は1。
  compactCount?: number;
}

const { compactCount = 1 } = Astro.props;
const tags: string[] = Array.isArray(Astro.props.tags) ? Astro.props.tags : [];
const overflowTotal =
  tags.length > compactCount ? tags.length - compactCount : 0;

// ユニークID（クライアントスクリプトで要素を参照するため）
const uid = `taglist-${Math.random().toString(36).slice(2, 9)}`;
---

{
  tags.length > 0 && (
    <div class="flex items-center gap-1">
      {" "}
      {tags.map((tag: unknown) => (
        <span class="rounded-full border bg-white px-2 py-0.5 text-[10px]">
          {" "}
          {tag}{" "}
        </span>
      ))}{" "}
    </div>
  )
}

