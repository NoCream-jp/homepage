---
interface Props {
  date: string;
  title: string;
  href?: string;
}

const { date, title, href } = Astro.props;

const Element = href ? "a" : "div";
---

<Element
  href={href}
  class:list={[
    "group flex gap-5 py-1 text-black",
    href ? "hover:text-primary cursor-pointer" : "",
  ]}
>
  <time class="text-label shrink-0 tracking-widest">
    {date}
  </time>

  <div class="flex-1">
    {title}
  </div>

  {
    href && (
      <div class="ml-4 flex shrink-0 items-center justify-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hover:text-primary"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </div>
    )
  }
</Element>
