---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";
import MultiImages from "./MultiImages.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const href = `/blog/${post.id}`;

const formattedDate = post.data.date
  ? post.data.date.toLocaleDateString("ja-JP")
  : "";
---

<a
  href={href}
  class="group flex min-h-20 w-full items-stretch gap-3 py-2 md:gap-5 md:py-3"
>
  <!-- 左：テキスト領域 -->
  <div class="flex min-w-0 flex-1 flex-col justify-between gap-1">
    <!-- タイトル -->
    <p
      class="text-sm leading-snug font-medium text-zinc-900 group-hover:text-zinc-600"
    >
      {post.data.title}
    </p>

    <!-- メタ情報 -->
    <div
      class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 text-[11px]"
    >
      <span class="text-zinc-400">{formattedDate}</span>
      <TagList tags={post.data.tags} />
    </div>
  </div>

  <!-- 右：画像（扇） -->
  <div class="flex w-16 shrink-0 items-center justify-center">
    <MultiImages images={post.data.images} />
  </div>
</a>
