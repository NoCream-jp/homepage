---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";
import MultiImages from "./MultiImages.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const href = `/blog/${post.id}`;

const formattedDate = post.data.date
  ? post.data.date.toLocaleDateString("ja-JP")
  : "";
---

<a
  href={href}
  class="group flex min-h-25 w-full items-stretch gap-5 border-t py-3"
>
  <!-- 左：テキスト領域 -->
  <div class="flex flex-1 flex-col justify-between gap-1">
    <!-- タイトル -->
    <p
      class="text-sm leading-snug font-medium text-zinc-900 group-hover:text-zinc-600"
    >
      {post.data.title}
    </p>

    <!-- メタ情報 -->
    <div class="flex justify-between gap-2 text-[11px]">
      <span class="text-zinc-400">{formattedDate}</span>
      <TagList tags={post.data.tags} />
    </div>
  </div>

  <!-- 中央仕切り -->
  <!-- <div class="border-r"></div> -->

  <!-- 右：画像（扇） -->
  <div class="flex w-16 items-center justify-center">
    <MultiImages images={post.data.images} />
  </div>
</a>
