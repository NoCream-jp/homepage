---
import NavLink from "./NavLink.astro";
---

<header
  class="md:w-sidebar fixed top-0 left-0 z-50 flex h-14 w-full items-center justify-center bg-white/70 px-2 backdrop-blur-md md:top-0 md:right-0 md:left-auto md:h-screen md:flex-col md:bg-white md:p-0 md:backdrop-blur-none"
>
  <nav
    class="flex w-full flex-row items-start justify-evenly gap-0.5 sm:gap-2 md:h-full md:flex-col"
  >
    <NavLink href="/#top" targetId="top" text="Top" />
    <NavLink href="/#news" targetId="news" text="News" />
    <NavLink href="/#about" targetId="about" text="About" />
    <NavLink href="/#blog" targetId="blog" text="Blog" />
    <NavLink href="/#action" targetId="action" text="Action" />
  </nav>
</header>

<script>
  // ページ読み込み時に実行されるスクロール監視ロジック
  function initScrollSpy() {
    // 監視対象となるトップページの各セクションとフッターを取得
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("[data-nav-target]");
    const footer = document.querySelector("#footer");

    // 現在の状態を保持する変数
    let currentActiveId = "";
    let isFooterVisible = false;

    // メニューのハイライト状態を更新する関数
    function updateNav() {
      navLinks.forEach((link) => {
        if (isFooterVisible) {
          // フッターが見えている時は全解除
          link.removeAttribute("data-active");
        } else {
          // そうでない時は現在の中央セクションをハイライト
          if (link.getAttribute("data-nav-target") === currentActiveId) {
            link.setAttribute("data-active", "true");
          } else {
            link.removeAttribute("data-active");
          }
        }
      });
    }

    // セクション監視用（画面の「中央」にセクションが来たときに発火）
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            currentActiveId = entry.target.getAttribute("id") || "";
            updateNav();
          }
        });
      },
      { rootMargin: "-50% 0px -50% 0px", threshold: 0 }
    );

    sections.forEach((section) => sectionObserver.observe(section));

    // フッター監視用（画面に少しでもフッターが見えたら発火）
    if (footer) {
      const footerObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isFooterVisible = entry.isIntersecting;
            updateNav();
          });
        },
        { rootMargin: "0px", threshold: 0.1 }
      );
      footerObserver.observe(footer);
    }
  }

  // 初回読み込み時
  initScrollSpy();
</script>
