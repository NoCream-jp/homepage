---
import NavLink from "./NavLink.astro";
---

<header
  class="md:w-sidebar fixed top-0 left-0 z-50 flex h-14 w-full items-center justify-center bg-white/70 px-2 backdrop-blur-md md:top-0 md:right-0 md:left-auto md:h-screen md:flex-col md:bg-white md:p-0 md:backdrop-blur-none"
>
  <nav
    class="flex w-full flex-row items-start justify-evenly gap-0.5 sm:gap-2 md:h-full md:flex-col"
  >
    <NavLink href="/#top" targetId="top">Top</NavLink>
    <NavLink href="/#news" targetId="news">News</NavLink>
    <NavLink href="/#about" targetId="about">About</NavLink>
    <NavLink href="/#blog" targetId="blog">Blog</NavLink>
    <NavLink href="/#work" targetId="work">Work</NavLink>
  </nav>
</header>

<script>
  // ページ読み込み時に実行されるスクロール監視ロジック
  function initScrollSpy() {
    // 監視対象となるトップページの各セクションを取得
    const sections = document.querySelectorAll("section[id]");
    // メニューバーの各リンクを取得
    const navLinks = document.querySelectorAll("[data-nav-target]");

    // 画面の「中央」にセクションが来たときに発火させる設定
    const observerOptions = {
      root: null,
      rootMargin: "-50% 0px -50% 0px", // 画面の上下50%を無視し、中央の1本の線を通過したかで判定
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const currentId = entry.target.getAttribute("id");

          // 一致するIDを持つリンクのみdata-activeをセットする
          navLinks.forEach((link) => {
            if (link.getAttribute("data-nav-target") === currentId) {
              link.setAttribute("data-active", "true");
            } else {
              link.removeAttribute("data-active");
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
  }

  // 初回読み込み時
  initScrollSpy();
</script>
