---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";
import MultiImages from "./MultiImages.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const href = `/blog/${post.id}`;

const formattedDate = post.data.date
  ? post.data.date.toLocaleDateString("ja-JP")
  : null;

const imageList = (post.data as any).images
  ? (post.data as any).images
  : post.data.image
    ? [post.data.image]
    : [];
---

<a href={href} class="group block h-full w-full">
  <article
    class="flex h-full w-full flex-col overflow-hidden rounded-md border border-zinc-800 bg-white p-4 transition hover:border-zinc-500"
  >
    <!-- サムネ  -->
    <MultiImages images={imageList} />

    <!-- footer -->
    <div class="mt-4 flex flex-1 flex-col justify-between gap-2">
      <div class="flex items-center justify-between">
        <h3 class="text-sm leading-snug font-medium text-zinc-800">
          {post.data.title}
        </h3>
      </div>

      <div class="mt-auto flex items-end justify-between">
        <div class="text-[11px] text-zinc-400">
          {formattedDate}
        </div>
        <TagList tags={post.data.tags} />
      </div>
    </div>
  </article>
</a>
