---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const href = `/blog/${post.id}`;

const formattedDate = post.data.date
  ? post.data.date.toLocaleDateString("ja-JP").replace(/\//g, ".")
  : null;
---

<a href={href} class="block">
  <article
    class="overflow-hidden rounded-md border border-zinc-200 bg-white transition hover:shadow-sm"
  >
    <!-- サムネ -->
    <div class="aspect-4/3 bg-zinc-200">
      {
        post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.title}
            class="h-full w-full object-cover"
          />
        )
      }
    </div>

    <!-- 下：メタ -->
    <div class="flex flex-col gap-2 p-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm leading-snug font-medium text-zinc-800">
          {post.data.title}
        </h3>

        <TagList tags={post.data.tags} />
      </div>

      {
        post.data.description && (
          <p class="line-clamp-2 text-xs text-zinc-500">
            {post.data.description}
          </p>
        )
      }

      <div class="text-[11px] text-zinc-400">
        {formattedDate}
      </div>
    </div>
  </article>
</a>
