---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const href = `/blog/${post.id}`;

const formattedDate = post.data.date
  ? post.data.date.toLocaleDateString("ja-JP")
  : null;
---

<a href={href} class="block h-full w-full">
  <article
    class="h-full w-full overflow-hidden rounded-md border bg-white transition hover:shadow-sm"
  >
    <!-- サムネ -->
    <!-- <div class="aspect-4/3 bg-white">
      {
        post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.title}
            class="h-full w-full object-cover"
          />
        )
      }
    </div> -->

    <!-- 下：メタ -->
    <div class="flex h-full flex-col justify-between gap-2 p-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm leading-snug font-medium text-zinc-800">
          {post.data.title}
        </h3>
      </div>
      <div class="flex justify-between">
        <div class="text-[11px] text-zinc-400">
          {formattedDate}
        </div>
        <TagList tags={post.data.tags} />
      </div>
    </div>
  </article>
</a>
