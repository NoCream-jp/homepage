---
import type { CollectionEntry } from "astro:content";

interface Props {
  items: CollectionEntry<"action-log">[];
}

const { items } = Astro.props as Props;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);
---

<section class="flex min-h-0 flex-col gap-4">
  <!-- <div class="flex items-center justify-end">
    <span class="text-sm text-zinc-600 tabular-nums">
      {items.length} entries
    </span>
  </div> -->

  <div class="relative rounded-md border border-(--site-border) p-5">
    <div
      class="absolute top-8 bottom-6 left-6 w-px bg-zinc-200"
      aria-hidden="true"
    >
    </div>
    <ol class="relative space-y-6">
      {
        items.map((item) => (
          <li class="relative grid grid-cols-[1.25rem_minmax(0,1fr)] gap-3">
            <span
              class="mt-1.5 h-2.5 w-2.5 rounded-full border-2 border-(--site-border-strong) bg-zinc-400 ring-1 ring-zinc-300"
              aria-hidden="true"
            />
            <div class="min-w-0">
              <time
                class="text-xs font-medium text-zinc-400"
                datetime={item.data.date.toISOString()}
              >
                {formatDate(item.data.date)}
              </time>
              <h3 class="mt-1 text-sm leading-6 font-medium text-zinc-900">
                {item.data.title}
              </h3>
              {item.data.description && (
                <p class="mt-1 text-sm leading-6 text-zinc-500">
                  {item.data.description}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
