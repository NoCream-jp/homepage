---
interface Props {
  images?: any[];
}

const { images = [] } = Astro.props;

// undefined や 空文字を除外した上で最大3枚を取得
const displayImages = images.filter(Boolean).slice(0, 3);
---

<div
  class:list={[
    "relative flex aspect-4/3 w-full items-center justify-center transition-transform",
    displayImages.length === 3 ? "origin-center scale-[0.8]" : "",
  ]}
>
  {
    displayImages.length === 0 ? (
      // 画像がない場合
      <div class="flex aspect-square w-[65%] max-w-40 flex-col items-center justify-center gap-1 rounded-md border border-zinc-800 bg-zinc-50 text-zinc-400">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="h-7 w-7 opacity-60"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
          />
        </svg>
        <span class="text-[10px] font-medium tracking-wider text-zinc-400 uppercase">
          No Image
        </span>
      </div>
    ) : (
      // 画像がある場合
      displayImages.map((img, i) => {
        const count = displayImages.length;

        const offset = i - (count - 1) / 2;
        const translateX = offset * -1.5;
        const translateY = offset * 1.2;
        const zIndex = 10 - i;

        const maxAngle = 20; // 全体の開き具合（調整ポイント）
        const step = count > 1 ? -maxAngle / (count - 1) : 0;
        const rotate = count > 1 ? maxAngle / 2 + step * i : 0;

        const src = typeof img === "object" && img.src ? img.src : img;

        return (
          <img
            src={src}
            alt=""
            class="absolute aspect-square w-[45%] max-w-40 rounded-md border border-zinc-500 bg-white object-cover shadow-sm"
            style={`
              transform: translate(${translateX}rem, ${translateY}rem) rotate(${rotate}deg);
              transform-origin: bottom center;
              z-index: ${zIndex};
            `}
          />
        );
      })
    )
  }
</div>
