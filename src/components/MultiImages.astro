---
interface Props {
  images?: any[];
}

const { images = [] } = Astro.props;

// null/undefined/空除外 + 最大3枚
const displayImages = images.filter(Boolean).slice(0, 3);
const count = displayImages.length;

const maxAngle = 30; // 扇の開き（少し広げた）
const step = count > 1 ? maxAngle / (count - 1) : 0;
const baseAngle = -maxAngle / 2;
---

<div class="relative flex h-full w-full items-center justify-center">
  {
    displayImages.length === 0 ? (
      <div class="flex flex-col items-center justify-center gap-1 rounded-md border border-zinc-800 bg-zinc-50 px-2 py-2 text-zinc-400">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="h-6 w-6 opacity-60"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
          />
        </svg>
        <span class="text-[10px] tracking-wider text-zinc-400 uppercase">
          No Image
        </span>
      </div>
    ) : (
      displayImages.map((img, i) => {
        const src = typeof img === "object" && img?.src ? img.src : img;

        const angle = count > 1 ? baseAngle + step * i : 0;

        // ほんの少しだけ上下にズラして奥行き感
        const yOffset = i * 0.15 - 0.5;

        return (
          <img
            src={src}
            alt=""
            class="absolute h-10 w-10 rounded-md border border-zinc-500 bg-white object-cover shadow-sm transition-transform"
            style={`
              transform:
                rotate(${angle}deg)
                translateY(${yOffset}rem);
              transform-origin: bottom center;
              z-index: ${10 - i};
            `}
          />
        );
      })
    )
  }
</div>
