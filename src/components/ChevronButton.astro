---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  direction: "left" | "right" | "up" | "down";
}

const { direction, class: className, ...rest } = Astro.props;

// 向きに応じたSVGのパスを定義
const paths = {
  left: "m15 18-6-6 6-6",
  right: "m9 18 6-6-6-6",
  up: "m18 15-6-6-6 6",
  down: "m6 9 6 6 6-6",
};
---

<button
  type="button"
  class:list={[
    "flex items-center justify-center rounded-full border bg-none p-2 text-black transition hover:text-zinc-600 disabled:pointer-events-none disabled:opacity-0",
    className,
  ]}
  {...rest}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-5 w-5"
    aria-hidden="true"
  >
    <path d={paths[direction]}></path>
  </svg>
</button>
